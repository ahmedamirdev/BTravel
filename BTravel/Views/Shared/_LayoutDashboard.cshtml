<!DOCTYPE html>
<html lang="en">
<head>
	<meta http-equiv="X-UA-Compatible" content="IE=edge" />
	<title>BTravelMate Admin Dashboard</title>
	<meta content="width=device-width, initial-scale=1.0, shrink-to-fit=no"
		  name="viewport" />

	<!-- Favicon -->
	<link rel="icon" href="~/PortalAssets/img/B.png" type="image/x.icon">

	<link href="~/dashboardassets/css/fonts.min.css" rel="stylesheet" />
	<link href="~/dashboardassets/css/fonts.css" rel="stylesheet" />
	<script src="~/dashboardassets/js/plugin/webfont/webfont.min.js"></script>
	<!-- Fonts and icons -->

	<script>
		WebFont.load({
		  google: { families: ["Public Sans:300,400,500,600,700"] },
		  custom: {
			families: [
			  "Font Awesome 5 Solid",
			  "Font Awesome 5 Regular",
			  "Font Awesome 5 Brands",
			  "simple-line-icons",
			],
			urls: ["~/dashBoardAssets/css/fonts.min.css"],
		  },
		  active: function () {
			sessionStorage.fonts = true;
		  },
		});
	</script>

	<!-- CSS Files -->
	<link rel="stylesheet" href="~/dashBoardAssets/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/dashBoardAssets/css/plugins.min.css" />
	<link rel="stylesheet" href="~/dashBoardAssets/css/kaiadmin.min.css" />

	@* <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> *@

	<!-- Select2 CSS & JS -->
	<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

	<!-- SweetAlert2 CSS & JS -->
	<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.20/dist/sweetalert2.min.css" rel="stylesheet">
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.20/dist/sweetalert2.min.js"></script>

	<style>
		.invalid-input {
			border: 2px solid red !important;
		}
	</style>
	<style>
		.pagination-container {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin: 15px 0;
			flex-wrap: wrap; /* Optional: wraps on smaller screens */
		}

		.pagination-summary p {
			margin: 0;
			font-size: 14px;
			color: #444;
		}

		.pagination-controls {
			margin-top: 0;
		}

		.pagination {
			list-style: none;
			display: flex;
			gap: 5px;
			padding: 0;
			margin: 0;
		}

			.pagination li {
				display: inline;
			}

			.pagination a, .pagination span {
				display: block;
				padding: 6px 12px;
				border: 1px solid #ddd;
				color: #007bff;
				text-decoration: none;
				border-radius: 4px;
			}

			.pagination .active span {
				background-color: #007bff;
				color: white;
				border-color: #007bff;
				font-weight: bold;
			}
	</style>
	<style>
		.nav-item .active {
			color: #007bff;
			font-weight: bold;
		}

		.nav-collapse .active {
			background-color: rgba(0, 123, 255, 0.1);
		}
	</style>
</head>
<body>
	<div class="wrapper">
		<div class="sidebar" data-background-color="dark">
			<div class="sidebar-logo">
				<div class="logo-header" data-background-color="dark">
					<a href="~/Dashboard/Index" class="logo">
						<img src="~/PortalAssets/img/logo-white.png" class="navbar-brand" style="max-width:90px; margin-left:5px;" alt="Logo">
					</a>
					<div class="nav-toggle">
						<button class="btn btn-toggle toggle-sidebar">
							<i class="gg-menu-right"></i>
						</button>
						<button class="btn btn-toggle sidenav-toggler">
							<i class="gg-menu-left"></i>
						</button>
					</div>
					<button class="topbar-toggler more">
						<i class="gg-more-vertical-alt"></i>
					</button>
				</div>
			</div>
			<div class="sidebar-wrapper scrollbar scrollbar-inner">
				<div class="sidebar-content">
					<ul class="nav nav-secondary">
						<li class="nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "Dashboard" && ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")">
							<a href="~/Dashboard/Index">
								<i class="fas fa-home"></i>
								<p>Dashboard</p>
							</a>
						</li>

						<!-- Booking Forms -->
						<li class="nav-section">
							<span class="sidebar-mini-icon">
								<i class="fa fa-ellipsis-h"></i>
							</span>
							<h4 class="text-section">Booking Forms</h4>
						</li>
						<li class="nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "Contracts" && ViewContext.RouteData.Values["action"].ToString() == "Add" ? "active" : "")">
							<a href="~/Contracts/Add">
								<i class="fas fa-plus"></i>
								<p>Add new Booking <br /><span style="font-size:11px;">(New Customer)</span></p>
							</a>
						</li>
						<li class="nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "Contracts" && ViewContext.RouteData.Values["action"].ToString() == "Add2" ? "active" : "")">
							<a href="~/Contracts/Add2">
								<i class="fas fa-plus"></i>
								<p>Add new Booking</p>
							</a>
						</li>
						<li class="nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "Contracts" && (ViewContext.RouteData.Values["action"].ToString() == "All" || ViewContext.RouteData.Values["action"].ToString() == "Details" || ViewContext.RouteData.Values["action"].ToString() == "Edit") ? "active" : "")">
							<a href="~/Contracts/All">
								<i class="fas fa-file-alt"></i>
								<p>Booking Forms</p>
							</a>
						</li>

						<!-- Users -->
						<li class="nav-section">
							<span class="sidebar-mini-icon">
								<i class="fa fa-ellipsis-h"></i>
							</span>
							<h4 class="text-section">Users</h4>
						</li>
						<li class="nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "Users" && ViewContext.RouteData.Values["action"].ToString() == "Add" ? "active" : "")">
							<a href="~/Users/Add">
								<i class="fas fa-user-plus"></i>
								<p>Add new User</p>
							</a>
						</li>
						<li class="nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "Users" && (ViewContext.RouteData.Values["action"].ToString() == "All" || ViewContext.RouteData.Values["action"].ToString() == "Details" || ViewContext.RouteData.Values["action"].ToString() == "Edit") ? "active" : "")">
							<a href="~/Users/All">
								<i class="fas fa-user-friends"></i>
								<p>Users List</p>
							</a>
						</li>
					</ul>
				</div>
			</div>
		</div>
		<div class="main-panel">
			<div class="main-header">
				<div class="main-header-logo">
					<!-- Logo Header Hidden -->
					<div class="logo-header" data-background-color="dark">
						<a href="index.html" class="logo">
							<img src="assets/img/kaiadmin/logo_light.svg" alt="navbar brand" class="navbar-brand" height="20" />
						</a>
						<div class="nav-toggle">
							<button class="btn btn-toggle toggle-sidebar">
								<i class="gg-menu-right"></i>
							</button>
							<button class="btn btn-toggle sidenav-toggler">
								<i class="gg-menu-left"></i>
							</button>
						</div>
						<button class="topbar-toggler more">
							<i class="gg-more-vertical-alt"></i>
						</button>
					</div>
					<!-- End Logo Header Hidden -->
				</div>
				<!-- Navbar Header -->
				<nav class="navbar navbar-header navbar-header-transparent navbar-expand-lg border-bottom">
					<div class="container-fluid">
						<nav class="navbar navbar-header-left navbar-expand-lg navbar-form nav-search p-0 d-none d-lg-flex">
							<div class="input-group">
								<div class="input-group-prepend">
									<button type="submit" class="btn btn-search pe-1" onclick="goToSearch()">
										<i class="fa fa-search search-icon"></i>
									</button>
								</div>
								<input id="txtSearch" name="txtSearch" type="text" placeholder="Search for Bookings ..." class="form-control" />&nbsp;&nbsp;&nbsp;
								<button type="submit" class="btn btn-primary ms-3 fw-bolder" onclick="goToSearch()">
									<span class="btn-label">Search</span>
								</button>
							</div>
						</nav>
						<ul class="navbar-nav topbar-nav ms-md-auto align-items-center">
							<li class="nav-item topbar-icon dropdown hidden-caret d-flex d-lg-none">
								<a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false" aria-haspopup="true">
									<i class="fa fa-search"></i>
								</a>
								<ul class="dropdown-menu dropdown-search animated fadeIn">
									<form class="navbar-left navbar-form nav-search">
										<div class="input-group">
											<input id="txtSearch2" type="text" placeholder="Search for Bookings ..." class="form-control" />
										</div>
									</form>
								</ul>
							</li>
							<li class="nav-item topbar-user dropdown hidden-caret">
								<a class="dropdown-toggle profile-pic" data-bs-toggle="dropdown" href="#" aria-expanded="false">
									<div class="avatar-sm">
										<img src="~/DashBoardAssets/img/defaultUser4.jpg" alt="..." class="avatar-img rounded-circle" />
									</div>
									<span class="profile-username">
										<span class="op-7">Hi,</span>
										<span class="fw-bold">@User.Identity.Name.Split(' ')[0]</span>
									</span>
								</a>
								<ul class="dropdown-menu dropdown-user animated fadeIn">
									<div class="dropdown-user-scroll scrollbar-outer">
									<li>
										<a class="dropdown-item" href="~/Users/ChangePassword">Change Password</a>
										<div class="dropdown-divider"></div>
										<a class="dropdown-item" href="~/Dashboard/Logout">Logout</a>
									</li>
					</div>
					</ul>
					</li>
					</ul>
			</div>
			</nav>
			<!-- End Navbar -->
		</div>

		@RenderBody();

		<footer class="footer text-center">
			<div class="copyright">
				<i class="far fa-copyright"></i> 2025, made with <i class="fa fa-heart heart text-danger"></i> by
				<a href="#">AhmeD, Safey</a>
			</div>
		</footer>

	</div>

	<!--   Core JS Files   -->
	<script src="~/dashBoardAssets/js/core/jquery-3.7.1.min.js"></script>
	<script src="~/dashBoardAssets/js/core/popper.min.js"></script>
	<script src="~/dashBoardAssets/js/core/bootstrap.min.js"></script>

	<!-- jQuery Scrollbar -->
	<script src="~/dashBoardAssets/js/plugin/jquery-scrollbar/jquery.scrollbar.min.js"></script>

	<!-- Chart JS -->
	<script src="~/dashBoardAssets/js/plugin/chart.js/chart.min.js"></script>

	<!-- jQuery Sparkline -->
	<script src="~/dashBoardAssets/js/plugin/jquery.sparkline/jquery.sparkline.min.js"></script>

	<!-- Chart Circle -->
	<script src="~/dashBoardAssets/js/plugin/chart-circle/circles.min.js"></script>

	<!-- Datatables -->
	<script src="~/dashBoardAssets/js/plugin/datatables/datatables.min.js"></script>

	<!-- Bootstrap Notify -->
	<script src="~/dashBoardAssets/js/plugin/bootstrap-notify/bootstrap-notify.min.js"></script>

	<!-- jQuery Vector Maps -->
	<script src="~/dashBoardAssets/js/plugin/jsvectormap/jsvectormap.min.js"></script>
	<script src="~/dashBoardAssets/js/plugin/jsvectormap/world.js"></script>

	<!-- Sweet Alert -->
	<script src="~/dashBoardAssets/js/plugin/sweetalert/sweetalert.min.js"></script>

	<!-- Kaiadmin JS -->
	<script src="~/dashBoardAssets/js/kaiadmin.min.js"></script>

	@* <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> *@

	<!-- Select2 CSS & JS -->
	<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>


	<script>

		// Listen for keydown event on the input
		document.getElementById("txtSearch").addEventListener("keydown", function (event) {
			if (event.key === "Enter") {
				event.preventDefault(); // prevent form submission if inside a form
				goToSearch();
			}
		});

		// Listen for keydown event on the input
		document.getElementById("txtSearch2").addEventListener("keydown", function (event) {
			if (event.key === "Enter") {
				event.preventDefault(); // prevent form submission if inside a form
				goToSearch();
			}
		});

		function goToSearch() {
			const searchValue = document.getElementById('txtSearch').value.trim();
			//if (searchValue) { uncomment if you want to not search if the search text is empty
				const url = `/Contracts/All?Search=${encodeURIComponent(searchValue)}`;
				window.location.href = url;
			//}
		}

		// Function to read the 'Search' query parameter and set the value in the input field
		function setSearchValueFromUrl() {
			const urlParams = new URLSearchParams(window.location.search);
			const searchQuery = urlParams.get('Search');
			if (searchQuery) {
				// Set the value of the search input field
				document.getElementById('txtSearch').value = decodeURIComponent(searchQuery);
			}
		}

		// Call the function to set the search value when the page loads
		window.onload = setSearchValueFromUrl;

	</script>

</body>
</html>
