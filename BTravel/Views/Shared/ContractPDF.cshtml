@using BTravel.CommonDefinitions.DTOs.Contract
@model ContractDTO
@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8">
	<title>Btravelmate</title>
	<meta content="width=device-width, initial-scale=1.0" name="viewport">
	<meta name="description" content="Business Travel, booking ,trip adviser,hotel,Exhibitions, Trade Fairs, Conferences, Meetings and Hotel Booking:">
	<meta content="" name="keywords">
	<meta content="" name="description">

	<!-- Icon Font Stylesheet -->
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

	<!-- Customized Bootstrap Stylesheet -->
	<link href="~/PortalAssets/css/bootstrap.min.css" rel="stylesheet">

	<!-- Template Stylesheet -->
	<link href="~/PortalAssets/css/style.css" rel="stylesheet">

	<!-- CSS Files -->
	<link rel="stylesheet" href="~/PortalAssets/css/MyBadges.css" />
	<link rel="stylesheet" href="~/PortalAssets/css/MyTables.css" />
	<link rel="stylesheet" href="~/PortalAssets/css/MyCards.css" />

	<style>
		table, tr, td, th {
			border: none !important;
			border-collapse: collapse !important;
			mso-border-alt: none !important;
			padding: 5px;
			vertical-align: top;
		}

		table {
			width: 100%;
			margin-bottom: 20px;
			border-spacing: 0;
		}

		* {
			border: none !important;
		}
	</style>
</head>

<body>
	<table>
		<tr>
			<td style="width: 30%">
				<img width="200px" height="120px" src="~/PortalAssets/img/logo-blue.png" alt="Logo">
			</td>
			<td style="width: 70%" class="text-end">
				<span style="font-size: 15px;">Address: 412 COVECREEK CIR, NE</span>
				<br />
				<span style="font-size: 15px;">CALGARY, AB ,T3K 0J6</span>
				<br />
				<span style="font-size: 15px;">Tel : +44 20 7193 5990</span>
				<br />
				<span style="font-size: 15px;">WWW.BTRAVELMATE.COM</span>
				<br />
				<span style="font-size: 15px;">Support@btravelmate.com</span>
			</td>
		</tr>
	</table>
	<table>
		<tr>
			<td style="width: 100%" class="text-center">
				<span style="font-size: 28px; font-weight:bold; color:black">Booking Form #@Model.ContractId</span>
			</td>
		</tr>
	</table>

	<div class="card">
		<div class="card-header">
			<div class="card-title">Hotel Details</div>
		</div>
		<div class="card-body">
			<table>
				<tr>
					<td style="width: 25%" class="text-start text-wrap" colspan="2">
						<strong style="color: #646464;">Hotel Name</strong>
						<br />
						<span style="font-weight: bold; font-size: 18px; color:#1a1a1a;" class="text-wrap">@Model.HotelName</span>
					</td>
					<td style="width: 25%" class="text-end">
						<strong style="color: #646464;">No. Of Rooms</strong>
						<br />
						<span class="badge badge-primary fw-bolder fs-5" style="">@Model.NoOfRooms</span>
					</td>
					<td style="width: 25%" class="text-end">
						<strong style="color: #646464;">No. Of Nights</strong>
						<br />
						<span class="badge badge-primary fw-bolder fs-5" style="">@Model.NoOfNights</span>
					</td>
				</tr>
				<tr>
					<td style="width: 50%" class="text-start" colspan="2">
						<strong style="color: #646464;">Created At</strong>
						<br />
						<span style="font-weight: bold; font-size: 18px; color:#1a1a1a;">@Model.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</span>
					</td>
					<td style="width: 25%" class="text-end">
						<strong style="color: #646464;">Rate / Night</strong>
						<br />
						<span class="badge badge-primary fw-bolder fs-5">@Model.RatePerNight <small style="font-size:12px;">EUR</small></span>
					</td>
					<td style="width: 25%" class="text-end">
						<strong style="color: #646464;">SubTotal</strong>
						<br />
						<span class="badge badge-success fw-bolder fs-5">@Model.SubTotal <small style="font-size:12px;">EUR</small></span>
					</td>

				</tr>
				<tr>
					
				</tr>
			</table>
		</div>
	</div>
	<div class="card">
		<div class="card-header">
			<div class="card-title">Customer Details</div>
		</div>
		<div class="card-body">
			<table>
				<tr>
					<td style="width: 33%" class="text-start text-wrap">
						<strong style="color: #646464;">Full Name</strong>
						<br />
						<span style="font-weight: bold; font-size: 18px; color:#1a1a1a;" class="text-wrap">@Model.CommonUser.FullName</span>
					</td>
					<td style="width: 33%" class="text-start text-wrap">
						<strong style="color: #646464;">Company Name</strong>
						<br />
						<span style="font-weight: bold; font-size: 18px; color:#1a1a1a;" class="text-wrap">@Model.CommonUser.CompanyName</span>
					</td>
					<td style="width: 33%" class="text-start text-wrap">
						<strong style="color: #646464;">Email</strong>
						<br />
						<span style="font-weight: bold; font-size: 18px; color:#1a1a1a;" class="text-wrap">@Model.CommonUser.PrimaryMail</span>
					</td>
				</tr>
				<tr>
					<td style="width: 33%" class="text-start text-wrap">
						<strong style="color: #646464;">Phone No.</strong>
						<br />
						<span style="font-weight: bold; font-size: 18px; color:#1a1a1a;" class="text-wrap">@Model.CommonUser.PhoneNumber</span>
					</td>
					<td style="width: 66%" class="text-start text-wrap" colspan="2">
						<strong style="color: #646464;">Signed At</strong>
						<br />
						<span style="font-weight: bold; font-size: 18px; color:#1a1a1a;" class="text-wrap">
							@{
								if (@Model.SignedAt.HasValue)
								{
									@Model.SignedAt.Value.ToString("dd/MM/yyyy hh:mm tt")
									;
								}
							}
						</span>
					</td>
				</tr>
			</table>
		</div>
	</div>
	<div class="card">
		<div class="card-header">
			<div class="card-title">Credit Card Details</div>
		</div>
		<div class="card-body">
			<table>
				<tr>
					<td style="width: 66%" class="text-start text-wrap" colspan="2">
						<strong style="color: #646464;">Card Holder</strong>
						<br />
						<span style="font-weight: bold; font-size: 18px; color:#1a1a1a;" class="text-wrap">@Model.NameOnCreditCard</span>
					</td>
					<td style="width: 33%" class="text-start text-wrap">
						<strong style="color: #646464;">Expire Date</strong>
						<br />
						@{
							DateTime expDate;
							var isParsed = DateTime.TryParse(Model.CardExpDate, out expDate);
							if (isParsed)
							{
								<span style="font-weight: bold; font-size: 18px; color:#1a1a1a;" class="text-wrap">@expDate.ToString("MM-yy")</span>
							}
							else
							{
								<span style="font-weight: bold; font-size: 18px; color:#1a1a1a;" class="text-wrap">@Model.CardExpDate</span>
							}
						}
					</td>
				</tr>
				<tr>
					<td style="width: 66%" class="text-start text-wrap" colspan="2">
						<strong style="color: #646464;">Card No.</strong>
						<br />
						<span style="font-weight: bold; font-size: 18px; color:#1a1a1a;" class="text-wrap">@Model.CardNumber</span>
					</td>
					<td style="width: 33%" class="text-start text-wrap">
						<strong style="color: #646464;">Card CVC</strong>
						<br />
						<span style="font-weight: bold; font-size: 18px; color:#1a1a1a;" class="text-wrap">@Model.CardCVC</span>
					</td>
				</tr>
				<tr>
					<td style="width: 66%" class="text-start text-wrap" colspan="2">
						<strong style="color: #646464;">Billing Address</strong>
						<br />
						<span style="font-weight: bold; font-size: 18px; color:#1a1a1a;" class="text-wrap">@Model.BillingAddress</span>
					</td>
					<td style="width: 33%" class="text-start text-wrap">
						<strong style="color: #646464;">Postal Code</strong>
						<br />
						<span style="font-weight: bold; font-size: 18px; color:#1a1a1a;" class="text-wrap">@Model.PostalCode</span>
					</td>
				</tr>
			</table>
			<div class="row">
				<div class="col-12">
					<h6 class="mt-4 mb-4 ms-2 me-2" style="color: #1a1a1a">
						<i class="fas fa-info-circle"></i>&nbsp; Terms and Conditions
					</h6>
					<p class="mt-4 mb-2 ms-2 me-2" style="color: #1a1a1a;">
						<b>By signing,</b> the customer agrees to the Terms and Conditions and Cancellation Policy listed in the agreement, as well as any previously agreed
						upon or to be agreed upon itinerary, bookings, and room accommodation reservations. The customer must provide complete and accurate
						information, and authorizes BTravelMate to collect payment for all relevant charges, including room charges, BTravelMate services, costs, fees,
						and taxes. BTravelMate is authorized to charge the credit card listed multiple times if necessary to satisfy the entire balance due. The customer
						certifies that they are the authorized signer of the credit card listed.
						BTravelMate provides competitive room rates and service pricing due to its ability to reserve, hold, and pre-pay for
						rooms for its clients at the time of reservation.
					</p>
				</div>
			</div>
			<div class="row">
				<div class="col-6 ms-2">
					<label class="mb-2" style="font-weight:bold; color:black;">Your Authorized Signature</label>
					<br />
					<img class="img-fluid  p-1" style="" src="@Model.SignatureUrl" alt="">
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<p class="mt-3 mb-0 ms-2 me-2" style="color: #1a1a1a;">
						<b>We offer</b> free cancellation for reservations made up to 20 days before the check-in date,
						recognizing that travel plans can change.To secure your
						reservation, we request valid credit card details at booking, with no immediate charge, ensuring your chosen rooms are held for you. We
						prioritize flexibility, allowing modifications to your reservation before the 20-day cancellation deadline. Payment for your stay is settled upon
						check-in, where our reception team will provide convenient payment options to enhance your stay experience.
					</p>
				</div>
			</div>
		</div>
	</div>
	<div class="card">
		<div class="card-header">
			<div class="card-title">Room Details</div>
		</div>
		<div class="card-body">
			<table id="basic-datatables" class="table align-items-center mb-0">
				<thead class="thead-light">
					<tr>
						<th scope="col" class="text-start">Room Type</th>
						<th scope="col" class="text-start">Names</th>
						<th style="width:5%; max-width:5%" scope="col" class="text-start text-wrap">Check In</th>
						<th style="width:5%; max-width:5%" scope="col" class="text-start text-wrap">Check Out</th>
						<th style="width:5%; max-width:5%" scope="col" class="text-start">No. Of Nights</th>
						<th scope="col" class="text-start">Amenities</th>
						<th scope="col" class="text-start">Comments</th>
					</tr>
				</thead>
				<tbody>
					@{
						if (Model.RoomsList.Count > 0)
						{
							foreach (var room in Model.RoomsList)
							{
								<tr style="color:#1a1a1a; border-bottom:1px solid lightgray !important">
									<th class="text-start">@room.RoomType</th>
									<td class="text-start">@room.Names</td>
									<td style="width:5%; max-width:5%" class="text-start">@room.CheckIn.ToString("dd/MM/yy")</td>
									<td style="width:5%; max-width:5%" class="text-start">@room.CheckOut.ToString("dd/MM/yy")</td>
									<td style="width:5%; max-width:5%" class="text-start">@room.NumOfNights</td>
									<td class="text-start">@room.RoomAmenities</td>
									<td class="text-start">@room.Comment</td>
								</tr>
							}
						}
					}
				</tbody>
			</table>
		</div>
	</div>
</body>

</html>