<script>
		document.getElementById("signatureForm").addEventListener("submit", function (e) {
		e.preventDefault(); // Stop form submission for now

		if (canvas.isEmpty()) {
			Swal.fire({
				icon: 'error',
				text: 'Please Provide Your Authorized Signature!'
			});
			return;
		}

		var signatureImage = canvas.toDataURL(); // Convert signature to Base64
		document.getElementById("signatureData").value = signatureImage;


		// Remove previous error borders
	this.querySelectorAll(".form-control").forEach(function (input) {
		input.classList.remove("is-invalid");
	});

	// Validate inputs manually
	var isValid = this.checkValidity();
	if (!isValid) {
		// Add red border to invalid fields
		this.querySelectorAll(".form-control:invalid").forEach(function (input) {
			input.classList.add("is-invalid");
		});

		// Show native error bubbles too
		this.reportValidity();
		return;
	}


	  // ✅ SweetAlert2 confirmation before final submission
	Swal.fire({
	  title: 'Are you sure ?',
	  html: `Do you want to sign <strong>Contract #@Model.ContractId</strong> ?`,
	  //text: "Do you want to sign this contract ?" + @Model.ContractId,
	  icon: 'question',
	  showCancelButton: true,
	  confirmButtonText: 'Confirm',
	  cancelButtonText: 'Cancel',
	  confirmButtonColor: '#28a745', // Bootstrap green
	  cancelButtonColor: '#dc3545'   // Bootstrap red
	}).then((result) => {
	  if (result.isConfirmed) {
		// If all good, submit
		this.submit(); // 👈 Now actually submit the form
	  }
	});




		// // Now check built-in form validity
		// if (this.checkValidity()) {
		// 	this.submit(); // Only submit if all validations pass
		// } else {
		// 	this.reportValidity(); // Show built-in browser validation messages
		// }
	});
</script>