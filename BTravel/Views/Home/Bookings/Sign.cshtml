@using BTravel.CommonDefinitions.DTOs.Contract;
@using BTravel.CommonDefinitions.Enums
@using BTravel.DAL.Entities;
@using System.Globalization
@model ContractDTO
@Html.AntiForgeryToken()
<!-- Import Fabric.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.0/fabric.min.js"></script>

<!-- CSS Files -->
<link rel="stylesheet" href="~/PortalAssets/css/MyBadges.css" />
<link rel="stylesheet" href="~/PortalAssets/css/MyTables.css" />
<link rel="stylesheet" href="~/PortalAssets/css/MyCards.css" />

<style>
	/*     Input    */
	.form-group,
	.form-check {
		margin-bottom: 0;
		padding: 10px;
	}

	/*    Input Icon */
	.input-icon {
		position: relative;
		color: #1a1a1a;
	}

		.input-icon .form-control:not(:first-child) {
			padding-left: 2.5rem;
		}

		.input-icon .form-control:not(:last-child) {
			padding-right: 2.5rem;
		}

		.input-icon .input-icon-addon {
			position: absolute;
			left: 1rem;
			top: 0;
			height: 100%;
			display: flex;
			align-items: center;
		}

			.input-icon .input-icon-addon:last-child {
				left: auto;
				right: 1rem;
			}


	.is-invalid {
		border: 2px solid red;
	}

	.icon-btn {
		background: none;
		border: none;
		padding: 0;
		margin: 0;
		cursor: pointer;
		outline: none;
	}
</style>


<!-- Page Header -->
<div class="container-fluid bg-primary pt-5 mb-5 hero-header">
	<div class="container pt-5">
		<div class="row justify-content-center pt-3">
			<div class="col-lg-10 text-center">
				<h1 class="display-3 text-white animated slideInDown fs-1">Booking <span class="badge badge-primary fw-bold fs-3" style="margin-top:-8px">#@Model.ContractId</span></h1>
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb justify-content-center">
						<li class="breadcrumb-item text-white">Home</li>
						<li class="breadcrumb-item text-white active" aria-current="page">Sign Booking</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</div>

<div class="container">
	<div class="row">
		<div class="col-md-12">
			<form id="signatureForm" asp-action="SignContract" asp-controller="Bookings" method="post" novalidate>
				<input hidden asp-for="ContractId" class="form-control" type="text" required />
				<div class="card">
					<div class="card-header">
						<div class="card-title">Hotel Details</div>
					</div>
					<div class="card-body">
						<div class="row">
							<div class="col-md-6 col-lg-6 text-wrap">
								<div class="form-group">
									<label style="font-weight:bold; color: #646464">Hotel Name</label>
									<div class="input-icon mt-1">
										<label class="fw-bold fs-5 text-wrap" style="color:#1a1a1a">@Model.HotelName</label>
									</div>
								</div>
							</div>
							<div class="col-md-2 col-lg-2">
								<div class="form-group">
									<label style="font-weight:bold; color: #646464">No. Of Rooms</label>
									<div class="input-icon mt-1">
										<label class="fw-bold fs-5 text-wrap" style="color:#1a1a1a">@Model.NoOfRooms</label>
									</div>
								</div>
							</div>
							<div class="col-md-2 col-lg-2">
								<div class="form-group">
									<label style="font-weight:bold; color: #646464">No. Of Nights</label>
									<div class="input-icon mt-1">
										<span class="badge badge-primary fw-bolder fs-5">@Model.NoOfNights</span>
									</div>
								</div>
							</div>
							<div class="col-md-2 col-lg-2">
								<div class="form-group">
									<label style="font-weight:bold; color: #646464">Rate / Night</label>
									<div class="input-icon mt-1">
										<span class="badge badge-primary fw-bolder fs-5">@Model.RatePerNight <small style="font-size:12px;">EUR</small></span>
									</div>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-md-10 col-lg-10">
								<div class="form-group">
									<label style="font-weight:bold; color: #646464">Created At</label>
									<div class="input-icon mt-1">
										<label class="fw-bold fs-5" style="color:#1a1a1a">@Model.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</label>
									</div>
								</div>
							</div>
							<div class="col-md-2 col-lg-2">
								<div class="form-group">
									<label style="font-weight:bold; color: #646464">SubTotal</label>
									<div class="input-icon mt-1">
										<span class="badge badge-success fw-bolder fs-4">@Model.SubTotal <small style="font-size:12px;">EUR</small></span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="card">
					<div class="card-header">
						<div class="card-title">
							Customer Details &nbsp;
							@{
								if (Model.StatusId == (int)EContractStatus.Pending)
								{
									<span class="badge badge-info fw-bolder">Pending</span>
								}
								else if (Model.StatusId == (int)EContractStatus.Opened)
								{
									<span class="badge badge-warning fw-bolder">Opened</span>
								}
								else if (Model.StatusId == (int)EContractStatus.Sigend)
								{
									<span class="badge badge-success fw-bolder">Signed</span>
								}
							}
						</div>
					</div>
					<div class="card-body">
						<div class="row">
							<div class="col-md-4 col-lg-4 text-wrap">
								<div class="form-group">
									<label style="font-weight:bold; color: #646464">Full Name</label>
									<div class="input-icon mt-1">
										<label class="fw-bold fs-5 text-wrap" style="color:#1a1a1a">@Model.CommonUser.FullName</label>
									</div>
								</div>
							</div>
							<div class="col-md-4 col-lg-4 text-wrap">
								<div class="form-group">
									<label style="font-weight:bold; color: #646464">Company Name</label>
									<div class="input-icon mt-1">
										<label class="fw-bold fs-5 text-wrap" style="color:#1a1a1a">@Model.CommonUser.CompanyName</label>
									</div>
								</div>
							</div>
							<div class="col-md-4 col-lg-4 text-wrap">
								<div class="form-group">
									<label style="font-weight:bold; color: #646464">Email</label>
									<div class="input-icon mt-1">
										<label class="fw-bold fs-5 text-wrap" style="color:#1a1a1a">@Model.CommonUser.PrimaryMail</label>
									</div>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-md-4 col-lg-4 text-wrap">
								<div class="form-group">
									<label style="font-weight:bold; color: #646464">Phone No.</label>
									<div class="input-icon mt-1">
										<label class="fw-bold fs-5 text-wrap" style="color:#1a1a1a">@Model.CommonUser.PhoneNumber</label>
									</div>
								</div>
							</div>
							<div class="col-md-4 col-lg-4 text-wrap">
								<div class="form-group">
									<label style="font-weight:bold; color: #646464">Viewed At</label>
									<div class="input-icon mt-1">
										<label class="fw-bold fs-5 text-wrap" style="color:#1a1a1a">
											@{
												if (Model.ViewedAt.HasValue)
												{
													@Model.ViewedAt.Value.ToString("dd/MM/yyyy hh:mm tt")
												}
											}
										</label>
									</div>
								</div>
							</div>
							<div class="col-md-4 col-lg-4 text-wrap">
								<div class="form-group">
									<label style="font-weight:bold; color: #646464">Signed At</label>
									<div class="input-icon mt-1">
										<label class="fw-bold fs-5 text-wrap" style="color:#1a1a1a">
											@{
												if (Model.SignedAt.HasValue)
												{
													@Model.SignedAt.Value.ToString("dd/MM/yyyy hh:mm tt")
												}
											}
										</label>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="card">
					<div class="card-header">
						<div class="card-title">Credit Card Details</div>
					</div>
					<div class="card-body">
						<div class="row">
							<div class="col-lg-6 col-md-12 col-sm-12 col-12">
								<div class="form-group">
									<label class="mb-2" style="font-weight:bold; color: #646464">Name on Credit Card</label>
									<div class="input-icon">
										<span class="input-icon-addon">
											<i class="fas fa-id-card"></i>
										</span>
										<input style="color: #1a1a1a" asp-for="NameOnCreditCard" class="form-control" type="text" required />
									</div>
								</div>
							</div>
							<div class="col-lg-6 col-md-12 col-sm-12 col-12">
								<div class="form-group">
									<label class="mb-2" style="font-weight:bold; color: #646464">Credit Card No.</label>
									<div class="input-icon">
										<span class="input-icon-addon">
											<i class="fas fa-credit-card"></i>
										</span>
										<input style="color: #1a1a1a" asp-for="CardNumber" class="form-control" type="text" required />
									</div>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-lg-6 col-md-12 col-sm-12 col-12">
								<div class="form-group">
									<label class="mb-2" style="font-weight:bold; color: #646464">Exp. Date</label>
									<div class="input-icon">
										<span class="input-icon-addon">
											<i class="fas fa-calendar-alt"></i>
										</span>
										<input style="color: #1a1a1a" asp-for="CardExpDate" type="date" class="form-control" min="@DateTime.Now.ToString("yyyy-MM-dd")" required />
									</div>
								</div>
							</div>
							<div class="col-lg-6 col-md-12 col-sm-12 col-12">
								<div class="form-group">
									<label class="mb-2" style="font-weight:bold; color: #646464">CVC. Code</label>
									<div class="input-icon">
										<span class="input-icon-addon">
											<i class="fas fa-credit-card"></i>
										</span>
										<input style="color: #1a1a1a" asp-for="CardCVC" class="form-control" type="text" required />
									</div>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-lg-6 col-md-12 col-sm-12 col-12">
								<div class="form-group">
									<label class="mb-2" style="font-weight:bold; color: #646464">Billing Address</label>
									<div class="input-icon">
										<span class="input-icon-addon">
											<i class="fas fa-map-marker-alt"></i>
										</span>
										<input style="color: #1a1a1a" asp-for="BillingAddress" class="form-control" type="text" required />
									</div>
								</div>
							</div>
							<div class="col-lg-6 col-md-12 col-sm-12 col-12">
								<div class="form-group">
									<label class="mb-2" style="font-weight:bold; color: #646464">Postal Code</label>
									<div class="input-icon">
										<span class="input-icon-addon">
											<i class="fas fa-info"></i>
										</span>
										<input style="color: #1a1a1a" asp-for="PostalCode" class="form-control" type="text" required />
									</div>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-12">
								<h6 class="mt-4 mb-4 ms-2 me-2" style="color: #1a1a1a">
									<i class="fas fa-info-circle"></i>&nbsp; Terms and Conditions
								</h6>
								<p class="mt-4 mb-2 ms-2 me-2" style="color: #1a1a1a;">
									<b>By signing,</b> the customer agrees to the Terms and Conditions and Cancellation Policy listed in the agreement, as well as any previously agreed
									upon or to be agreed upon itinerary, bookings, and room accommodation reservations. The customer must provide complete and accurate
									information, and authorizes BTravelMate to collect payment for all relevant charges, including room charges, BTravelMate services, costs, fees,
									and taxes. BTravelMate is authorized to charge the credit card listed multiple times if necessary to satisfy the entire balance due. The customer
									certifies that they are the authorized signer of the credit card listed.
									BTravelMate provides competitive room rates and service pricing due to its ability to reserve, hold, and pre-pay for
									rooms for its clients at the time of reservation.
								</p>
							</div>
						</div>
						<div class="row">
							<div class="col-6">
								<div class="form-group">
									<label class="mb-2" style="font-weight:bold; color:black;">Your Authorized Signature here</label>
									<div class="input-icon">
										<input type="hidden" asp-for="signatureData" name="SignatureData" id="signatureData">
										<canvas id="signatureCanvas" style="border: 1px solid #646464; min-width: 180%; margin-bottom:10px;"></canvas>
										@* <button type="button" id="clear" class="btn btn-link">Clear</button> *@
										<a href="javascript:void(0)" id="clear" style="margin-top:10px">Clear Signature</a>
									</div>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-12">
								<p class="mt-3 mb-0 ms-2 me-2" style="color: #1a1a1a;">
									<b>We offer</b> free cancellation for reservations made up to 20 days before the check-in date,
									recognizing that travel plans can change.To secure your
									reservation, we request valid credit card details at booking, with no immediate charge, ensuring your chosen rooms are held for you. We
									prioritize flexibility, allowing modifications to your reservation before the 20-day cancellation deadline. Payment for your stay is settled upon
									check-in, where our reception team will provide convenient payment options to enhance your stay experience.
								</p>
							</div>
						</div>
					</div>
				</div>
				<div class="card">
					<div class="card-header">
						<div class="card-title">Room Details</div>
					</div>
					<div class="card-body">
						<div class="row">
							<div class="col-md-12 col-lg-12">
								<div class="table-responsive">
									<table id="basic-datatables" class="table align-items-center mb-0">
										<thead class="thead-light">
											<tr>
												<th scope="col" class="text-start">Room Type</th>
												<th scope="col" class="text-start">Names</th>
												<th scope="col" class="text-start">Check In</th>
												<th scope="col" class="text-start">Check Out</th>
												<th scope="col" class="text-start">No. Of Nights</th>
												<th scope="col" class="text-start">Amenities</th>
												<th scope="col" class="text-start">Comments</th>
												@{
													if (Model.StatusId != (int)EContractStatus.Sigend)
													{
														<th scope="col" class="text-start">Actions</th>
													}
												}
											</tr>
										</thead>
										<tbody>
											@{
												if (Model.RoomsList != null)
												{
													for (int i = 0; i < Model.RoomsList.Count; i++)
													{
														<tr id="row-@Model.RoomsList[i].ContractRoomId" style="color:#1a1a1a">

															@* Hidden IDs *@
															<input type="hidden" name="RoomsList[@i].ContractId" value="@Model.ContractId" />
															<input type="hidden" name="RoomsList[@i].ContractRoomId" value="@Model.RoomsList[i].ContractRoomId" />
															<input type="hidden" name="RoomsList[@i].RoomType" value="@Model.RoomsList[i].RoomType" />
															<input type="hidden" name="RoomsList[@i].CheckIn" value="@Model.RoomsList[i].CheckIn" />
															<input type="hidden" name="RoomsList[@i].CheckOut" value="@Model.RoomsList[i].CheckOut" />
															<input type="hidden" name="RoomsList[@i].NumOfNights" value="@Model.RoomsList[i].NumOfNights" />
															<input type="hidden" name="RoomsList[@i].RoomAmenities" value="@Model.RoomsList[i].RoomAmenities" />
															<input type="hidden" name="RoomsList[@i].Comment" value="@Model.RoomsList[i].Comment" />
															<input type="hidden" name="RoomsList[@i].Deadline" value="@Model.RoomsList[i].Deadline" />
															<input type="hidden" name="RoomsList[@i].CreatedAt" value="@Model.RoomsList[i].CreatedAt" />

															<input type="hidden" id="input-RoomId-@Model.RoomsList[i].ContractRoomId" name="RoomsList[@i].ContractRoomId" value="@Model.RoomsList[i].ContractRoomId" />

															<td class="text-start">@Model.RoomsList[i].RoomType</td>
															<td class="text-start">
																<span class="view-mode">@Model.RoomsList[i].Names</span>
																@{
																	if (Model.StatusId != (int)EContractStatus.Sigend)
																	{
																		<input type="text" id="input-Name-@Model.RoomsList[i].ContractRoomId" name="RoomsList[@i].Names" value="@Model.RoomsList[i].Names" class="form-control edit-mode d-none" />
																	}
																}
															</td>
															<td class="text-start">@Model.RoomsList[i].CheckIn.ToShortDateString()</td>
															<td class="text-start">@Model.RoomsList[i].CheckOut.ToShortDateString()</td>
															<td class="text-start">@Model.RoomsList[i].NumOfNights</td>
															<td class="text-start">@Model.RoomsList[i].RoomAmenities</td>
															<td class="text-start">@Model.RoomsList[i].Comment</td>
															@{
																if (Model.StatusId != (int)EContractStatus.Sigend)
																{
																	<td class="text-center">
																		<a style="cursor:pointer" class="edit-btn" title="Edit" data-id="@Model.RoomsList[i].ContractRoomId">
																			<i class="fas fa-pen text-success" style="font-size:20px;"></i>
																		</a>
																		<button type="button" style="cursor:pointer" class="save-btn icon-btn d-none me-1" title="Save" data-id="@Model.RoomsList[i].ContractRoomId">
																			<i class="fas fa-check text-success" style="font-size:25px;"></i>
																		</button>
																		<a style="cursor:pointer" class="cancel-btn d-none" title="Cancel" data-id="@Model.RoomsList[i].ContractRoomId">
																			<i class="fas fa-times text-danger" style="font-size:25px;"></i>
																		</a>
																	</td>
																}
															}
														</tr>
													}
												}
											}
										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>
					<div class="card-action">
						<button class="btn btn-success" type="submit" style="font-weight:bold">Submit Booking</button>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>

<script>
		document.addEventListener("DOMContentLoaded", function () {
		const editButtons = document.querySelectorAll(".edit-btn");
		const cancelButtons = document.querySelectorAll(".cancel-btn");
		const saveButtons = document.querySelectorAll(".save-btn");

		// Handle Edit
		editButtons.forEach(button => {
			button.addEventListener("click", function () {
				const id = this.getAttribute("data-id");
				const row = document.getElementById("row-" + id);

				// Show/Hide appropriate elements
				row.querySelector(".view-mode").classList.add("d-none");
				row.querySelector(".edit-mode").classList.remove("d-none");
				row.querySelector(".edit-btn").classList.add("d-none");
				row.querySelector(".save-btn").classList.remove("d-none");
				row.querySelector(".cancel-btn").classList.remove("d-none");
			});
		});

		// Handle Cancel
		cancelButtons.forEach(button => {
			button.addEventListener("click", function () {
				const id = this.getAttribute("data-id");
				const row = document.getElementById("row-" + id);

				// Restore visibility
				row.querySelector(".view-mode").classList.remove("d-none");
				row.querySelector(".edit-mode").classList.add("d-none");
				row.querySelector(".edit-btn").classList.remove("d-none");
				row.querySelector(".save-btn").classList.add("d-none");
				row.querySelector(".cancel-btn").classList.add("d-none");

				// Reset input value to original text
				const originalValue = row.querySelector(".view-mode").textContent.trim();
				row.querySelector("input").value = originalValue;
			});
		});

		// Handle Save
		saveButtons.forEach(button => {
			button.addEventListener("click", function () {

				const id = this.getAttribute("data-id");
				const row = document.getElementById("row-" + id);
				const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

				const roomId = document.getElementById("input-RoomId-" + id).value;
				const Names = document.getElementById("input-Name-" + id).value;

				// Build full room object from row
				const roomData = {
					ContractRoomId: roomId,
					ContractId: @Model.ContractId,
					Names: Names,
					// RoomType: row.children[0].textContent.trim(),
					// CheckIn: row.children[2].textContent.trim(),
					// CheckOut: row.children[3].textContent.trim(),
					// NumOfNights: row.children[4].textContent.trim(),
					// RoomAmenities: row.children[5].textContent.trim(),
					// Comment: row.children[6].textContent.trim()
				};

					// Valid payload
					// {
					//   "ContractRoomId": 94,
					//   "ContractId": 35,
					//   "Names": "Ahmed Amir Mohamed Farag",
					//   "RoomType": "Standard",
					//   "CheckIn": "2025-07-06T00:00:00",
					//   "CheckOut": "2025-07-10T00:00:00",
					//   "NumOfNights": 4,
					//   "RoomAmenities": "Wi-Fi, AC",
					//   "Comment": "Sea view room"
					// }

				fetch("/Bookings/UpdateRoom2", {
					method: "POST",
					headers: {
						'Content-Type': 'application/json',
						'RequestVerificationToken': token
					},
					body: JSON.stringify(roomData)
				})
				.then(response => response.json())
				.then(data => {
					if (data.success) {
						Swal.fire({
							icon: 'success',
							title: 'Success!',
							text: data.message
						});

					const row = document.getElementById("row-" + id);
					row.querySelector(".view-mode").textContent = Names;
					row.querySelector(".view-mode").classList.remove("d-none");
					row.querySelector(".edit-mode").classList.add("d-none");
					row.querySelector(".edit-btn").classList.remove("d-none");
					row.querySelector(".save-btn").classList.add("d-none");
					row.querySelector(".cancel-btn").classList.add("d-none");
					} else {
						Swal.fire({
							icon: 'error',
							title: 'Error!',
							text: data.message
						});
					}
				})
				.catch(error => {
					Swal.fire({
						icon: 'error',
						title: 'Error!',
						text: 'An unexpected error occurred.'
					});
				});

			});
		});
	});
</script>


