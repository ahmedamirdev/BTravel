
<!-- CSS Files -->
<link rel="stylesheet" href="~/PortalAssets/css/MyBadges.css" />
<link rel="stylesheet" href="~/PortalAssets/css/MyTables.css" />
<link rel="stylesheet" href="~/PortalAssets/css/MyCards.css" />

<style>
	/*     Input    */
	.form-group,
	.form-check {
		margin-bottom: 0;
		padding: 10px;
	}

	/*    Input Icon */
	.input-icon {
		position: relative;
		color: #1a1a1a;
	}

		.input-icon .form-control:not(:first-child) {
			padding-left: 2.5rem;
		}

		.input-icon .form-control:not(:last-child) {
			padding-right: 2.5rem;
		}

		.input-icon .input-icon-addon {
			position: absolute;
			left: 1rem;
			top: 0;
			height: 100%;
			display: flex;
			align-items: center;
		}

			.input-icon .input-icon-addon:last-child {
				left: auto;
				right: 1rem;
			}


	.is-invalid {
		border: 2px solid red;
	}
</style>


<!-- Page Header -->
<div class="container-fluid bg-primary pt-5 mb-5 hero-header">
	<div class="container pt-5">
		<div class="row justify-content-center pt-3">
			<div class="col-lg-10 text-center">
				<h1 class="display-3 text-white animated slideInDown fs-1">Test</h1>
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb justify-content-center">
						<li class="breadcrumb-item text-white">Test</li>
						<li class="breadcrumb-item text-white active" aria-current="page">Send Email</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</div>

<div class="container">
	<div class="row">
		<div class="col-md-12">
			<form id="editForm" asp-action="TestEmail" asp-controller="Home" method="post" novalidate>
				<div class="card">
					<div class="card-header">
						<div class="card-title">Send Email</div>
					</div>
					<div class="card-body">
						<div class="row">
							<div class="col-lg-6 col-md-12 col-sm-12 col-12">
								<div class="form-group">
									<label class="mb-2" style="font-weight:bold; color: #646464">Email Address</label>
									<div class="input-icon">
										<span class="input-icon-addon">
											<i class="fas fa-lock"></i>
										</span>
										<input style="color: #1a1a1a" name="EmailAddress" class="form-control" type="text" required />
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="card-action">
						<button class="btn btn-success" type="submit" style="font-weight:bold">Send Email</button>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>





<script>




	document.getElementById("editForm").addEventListener("submit", function (e) {
		e.preventDefault(); // Stop form submission for now


		// Remove previous error borders
	this.querySelectorAll(".form-control").forEach(function (input) {
		input.classList.remove("is-invalid");
	});

	// Validate inputs manually
	var isValid = this.checkValidity();
	if (!isValid) {
		// Add red border to invalid fields
		this.querySelectorAll(".form-control:invalid").forEach(function (input) {
			input.classList.add("is-invalid");
		});

		// Show native error bubbles too
		this.reportValidity();
		return;
	}

	this.submit();

	});
</script>