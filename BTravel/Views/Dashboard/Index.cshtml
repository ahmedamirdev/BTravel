@using BTravel.CommonDefinitions.DTOs
@using BTravel.CommonDefinitions.Enums
@using BTravel.CommonDefinitions.Responses
@using BTravel.DAL.Entities;
@model DashboardDTO;

@{
	var successMessage = TempData["SuccessMessage"] as string;
	var errorMessage = TempData["ErrorMessage"] as string;
}
@if (!string.IsNullOrEmpty(successMessage))
{
	<script>
		Swal.fire({
			icon: 'success',
			title: 'Success!',
			text: '@successMessage'
		});
	</script>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
	<script>
		Swal.fire({
			icon: 'error',
			title: 'Error!',
			text: '@errorMessage'
		});
	</script>
}

<div class="container">
	<div class="page-inner">
		<div class="page-header">
			<h4 class="fw-bold mb-3">BTravel Dashboard</h4>
		</div>

		<div class="row">
			<div class="col-sm-6 col-md-3">
				<div class="card card-stats card-round">
					<div class="card-body">
						<div class="row align-items-center">
							<div class="col-icon">
								<div class="icon-big text-center icon-primary bubble-shadow-small">
									<i class="fas fa-users"></i>
								</div>
							</div>
							<div class="col col-stats ms-3 ms-sm-0">
								<div class="numbers">
									<p class="card-category fw-bold">Total Customers</p>
									<h4 class="card-title fw-extrabold">@Model.TotalNumOfCustomers</h4>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-sm-6 col-md-3">
				<div class="card card-stats card-round">
					<div class="card-body">
						<div class="row align-items-center">
							<div class="col-icon">
								<div class="icon-big text-center icon-info bubble-shadow-small">
									<i class="fas fa-exclamation"></i>
								</div>
							</div>
							<div class="col col-stats ms-3 ms-sm-0">
								<div class="numbers">
									<p class="card-category fw-bold">Pending Contracts</p>
									<h4 class="card-title fw-extrabold">@Model.PendingContracts</h4>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-sm-6 col-md-3">
				<div class="card card-stats card-round">
					<div class="card-body">
						<div class="row align-items-center">
							<div class="col-icon">
								<div class="icon-big text-center icon-success bubble-shadow-small">
									<i class="fas fa-check"></i>
								</div>
							</div>
							<div class="col col-stats ms-3 ms-sm-0">
								<div class="numbers">
									<p class="card-category fw-bold">Signed Contracts</p>
									<h4 class="card-title fw-extrabold">@Model.SignedContracts</h4>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-sm-6 col-md-3">
				<div class="card card-stats card-round">
					<div class="card-body">
						<div class="row align-items-center">
							<div class="col-icon">
								<div class="icon-big text-center icon-warning bubble-shadow-small">
									<i class="fas fa-user-clock"></i>
								</div>
							</div>
							<div class="col col-stats ms-3 ms-sm-0">
								<div class="numbers">
									<p class="card-category fw-bold">Opened Contracts</p>
									<h4 class="card-title fw-extrabold">@Model.OpenedContracts</h4>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="row">
			<div class="col-md-8">
				<div class="card card-round">
					<div class="card-header">
						<div class="card-head-row">
							<div class="card-title">Latest Contracts</div>
						</div>
					</div>
					<div class="card-body p-0">
						<div class="table-responsive">
							<table class="table align-items-center mb-0">
								<thead class="thead-light">
									<tr>
										<th scope="col">#ID</th>
										<th scope="col" class="text-start">Hotel</th>
										<th scope="col" class="text-start">Customer</th>
										<th scope="col" class="text-end">Total</th>
										<th scope="col" class="text-end">Status</th>
										<th scope="col" class="text-end">Created At</th>
									</tr>
								</thead>
								<tbody>
									@{
										foreach (var item in Model.LatestContracts)
										{
											<tr>
												<th scope="row">
													<a target="_blank" href="~/Contracts/Details/@item.ContractId">#@item.ContractId</a>
												</th>
												<td class="text-start">@item.HotelName</td>
												<td class="text-start">@item.CommonUser.FullName</td>
												<td class="text-end fw-extrabold">@item.Total</td>
												<td class="text-end">
													@{
														if (item.StatusId == (int)EContractStatus.Pending)
														{
															<span class="badge badge-info fw-bolder">Pending</span>
														}
														else if (item.StatusId == (int)EContractStatus.Opened)
														{
															<span class="badge badge-warning fw-bolder">Opened</span>
														}
														else if (item.StatusId == (int)EContractStatus.Sigend)
														{
															<span class="badge badge-success fw-bolder">Signed</span>
														}
													}
												</td>
												<td class="text-end">@item.CreatedAt.ToString("dd/MM/yy h:mm tt")</td>
											</tr>

										}
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="card card-primary bg-primary-gradient">
					<div class="card-body skew-shadow">
						<h1 class="fw-bolder">@Model.TotalSalesAllTime <span class="fs-5">EGP</span></h1>
						<h5 class="op-8">Total Sales</h5>
						<div class="pull-left mt-3">
							<label>From <span class="fw-bold">@Model.FirstContractCreatedAt.ToString("MMMM yyyy")</span>  - Till now</label>
						</div>
					</div>
				</div>
				<div class="card card-success bg-success-gradient">
					<div class="card-body skew-shadow">
						<h1 class="fw-bolder">@Model.TotalSalesLastWeek <span class="fs-5">EGP</span></h1>
						<h5 class="op-8">Last Week Sales</h5>
						<div class="pull-left mt-3">
							<label>From <span class="fw-bold">@Model.LastWeekStartAt.ToString("dddd dd MMMM")</span> - Till now</label>
						</div>
					</div>
				</div>
				<div class="card card-round">
					<div class="card-body">
						<div class="card-title fw-mediumbold">Latest Customers</div>
						<div class="card-list">
							@{
								foreach (var item in Model.LatestUsers)
								{
									<div class="item-list">
										<div class="avatar">
											<img src="~/DashBoardAssets/img/jm_denis.jpg" class="avatar-img rounded-circle" />
										</div>
										<div class="info-user ms-3">
											<div class="username">@item.FullName</div>
											<div class="status">@item.PhoneNumber</div>
										</div>
										@{
											if (item.RoleId == (int)ERole.Admin)
											{
												<span class="badge badge-success fw-bolder">Admin</span>
											}
											else if (item.RoleId == (int)ERole.Client)
											{
												<span class="badge badge-info fw-bolder">Customer</span>
											}
										}
										
									</div>
								}
							}
						</div>
					</div>
				</div>
			</div>
		</div>

	</div>
</div>