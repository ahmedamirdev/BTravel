@using BTravel.CommonDefinitions.DTOs.CommonUser
@using BTravel.CommonDefinitions.DTOs.Contract;
@using BTravel.CommonDefinitions.Enums
@using BTravel.CommonDefinitions.Responses
@using BTravel.DAL.Entities;
@model BaseResponse<IEnumerable<CommonUserDTO>>;

@{
	var successMessage = TempData["SuccessMessage"] as string;
	var errorMessage = TempData["ErrorMessage"] as string;
}
@if (!string.IsNullOrEmpty(successMessage))
{
	<script>
		Swal.fire({
			icon: 'success',
			title: 'Success!',
			text: '@successMessage'
		});
	</script>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
	<script>
		Swal.fire({
			icon: 'error',
			title: 'Error!',
			text: '@errorMessage'
		});
	</script>
}

<style>
	.icon-btn {
		background: none;
		border: none;
		padding: 0;
		margin: 0;
		cursor: pointer;
		outline: none;
	}

	.no-wrap {
		white-space: nowrap;
		/* display: flex; */
		align-items: center;
		/* justify-content: flex-end; */ /* since you had text-end */
		gap: 6px; /* spacing between buttons if you want */
	}
</style>


<div class="container">
	<div class="page-inner">
		<div class="page-header">
			<h4 class="fw-bold mb-3">Users List</h4>
			<ul class="breadcrumbs mb-3">
				<li class="nav-home">
					<a href="~/Dashboard/Index">
						<i class="icon-home"></i>
					</a>
				</li>
				<li class="separator">
					<i class="icon-arrow-right"></i>
				</li>
				<li class="nav-item">
					<a href="#">Users</a>
				</li>
				<li class="separator">
					<i class="icon-arrow-right"></i>
				</li>
				<li class="nav-item">
					<a href="#">All</a>
				</li>
			</ul>
		</div>
		<div class="row">
			<div class="col-md-12">
				<div class="table-responsive">
					@{
						if (Model.Data == null || Model.Data.Count() <= 0)
						{
							<h4 class="fw-bold mb-3">No data found</h4>
						}
					}
					<table id="basic-datatables" class="table align-items-center mb-0">
						<thead class="thead-light">
							<tr>
								<th scope="col">#ID</th>
								<th scope="col" class="text-start">Full Name</th>
								<th scope="col" class="text-start">Email</th>
								<th scope="col" class="text-start">Phone No.</th>
								<th scope="col" class="text-center">Created At</th>
								<th scope="col" class="text-end">Role</th>
								<th scope="col" class="text-end">Actions</th>
							</tr>
						</thead>
						<tbody>
							@{
								foreach (var item in Model.Data)
								{
									<tr>
										<th scope="row">
											<a target="_blank" href="~/Users/Details/@item.CommonUserId">#@item.CommonUserId</a>
										</th>
										<td class="text-start">@item.FullName</td>
										<td class="text-start">@item.PrimaryMail</td>
										<td class="text-start">@item.PhoneNumber</td>
										<td class="text-center">@item.CreatedAt.ToShortDateString()</td>
										<td class="text-end">
											@{
												if (item.RoleId == (int)ERole.Admin)
												{
													<span class="badge badge-success fw-bolder">Admin</span>
												}
												else if (item.RoleId == (int)ERole.Client)
												{
													<span class="badge badge-info fw-bolder">Customer</span>
												}
											}
										</td>
										<td class="text-end no-wrap">
											<a style="margin-right:2px;" target="_blank" href="~/Users/Edit/@item.CommonUserId" title="Edit">
												<i class="fas fa-pen text-success" style="font-size:18px;"></i>
											</a>
											<button style="cursor:pointer" class="icon-btn" data-bs-toggle="modal" data-bs-target="#deleteModal" title="Delete" onclick="setDeleteUserId(@item.CommonUserId)">
												<i class="fas fa-times text-danger" style="font-size:26px;"></i>
											</button>
										</td>
									</tr>
								}
							}
						</tbody>
					</table>
					<div class="pagination-container">
						<div class="pagination-summary">
							<p>Showing @Model.From to @Model.To of @Model.TotalCount entries</p>
						</div>
						<div class="pagination-controls">
							@if (Model.TotalPages > 1)
							{
								<ul class="pagination">
									@if ((Model.PageIndex + 1) > 1)
									{
										<li><a href="@Url.Action("All" , "Users", new { PageIndex = Model.PageIndex - 1 })">Prev</a></li>
									}

									@for (int i = 1; i <= Model.TotalPages; i++)
									{
										if (i == (Model.PageIndex + 1))
										{
											<li class="active"><span>@i</span></li>
										}
										else
										{
											<li><a href="@Url.Action("All" , "Users", new { PageIndex = i - 1 })">@i</a></li>
										}
									}

									@if ((Model.PageIndex + 1) < Model.TotalPages)
									{
										<li><a href="@Url.Action("All" , "Users", new { PageIndex = Model.PageIndex + 1 })">Next</a></li>
									}
								</ul>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Delete User Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<form id="deleteUser" method="post" asp-action="Delete" asp-controller="Users">
				<div class="modal-header">
					<h5 class="modal-title" id="deleteModalLabel">Delete User <span id="modalDeleteUserId" class="fw-bolder"></span></h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>

				<div class="modal-body">
					<input type="hidden" name="CommonUserId" id="DeleteCommonUserId" />
					<h5>Are you sure you want to delete user ?</h5>
					<small class="text-danger">** All data will be lost</small>
				</div>

				<div class="modal-footer">
					<button type="submit" class="btn btn-success">Delete</button>
					<button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancel</button>
				</div>
			</form>
		</div>
	</div>
</div>

<script>
	function setDeleteUserId(id) {
		document.getElementById("DeleteCommonUserId").value = id;
		document.getElementById("modalDeleteUserId").textContent = "#" + id;
	}
</script>