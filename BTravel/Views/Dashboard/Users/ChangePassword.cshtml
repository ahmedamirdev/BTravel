@using BTravel.CommonDefinitions.DTOs.CommonUser;
@using BTravel.DAL.Entities;
@model ChangePasswordDTO

@{
	var successMessage = TempData["SuccessMessage"] as string;
	var errorMessage = TempData["ErrorMessage"] as string;
}
@if (!string.IsNullOrEmpty(successMessage))
{
	<script>
		Swal.fire({
			icon: 'success',
			title: 'Success!',
			text: '@successMessage'
		});
	</script>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
	<script>
		Swal.fire({
			icon: 'error',
			title: 'Error!',
			text: '@errorMessage'
		});
	</script>
}

<div class="container">
	<div class="page-inner">
		<div class="page-header">
			<h4 class="fw-bold mb-3">
				Change Password
			</h4>
			<ul class="breadcrumbs mb-3">
				<li class="nav-home">
					<a href="~/Dashboard/Index">
						<i class="icon-home"></i>
					</a>
				</li>
				<li class="separator">
					<i class="icon-arrow-right"></i>
				</li>
				<li class="nav-item">
					<a href="#">Customer</a>
				</li>
				<li class="separator">
					<i class="icon-arrow-right"></i>
				</li>
				<li class="nav-item">
					<a href="#">Change Password</a>
				</li>
			</ul>
		</div>
		<div class="row">
			<div class="col-md-12">
				<form id="editForm" asp-action="ChangePassword" asp-controller="Users" method="post" novalidate>
					<input hidden asp-for="CommonUserId" class="form-control" type="text" required />
					<div class="card">
						<div class="card-body">
							<div class="row">
								<div class="col-md-6">
									<div class="form-group">
										<label style="font-weight:bold">Old Password</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-lock"></i>
											</span>
											<input asp-for="OldPassword" class="form-control" type="password" required />
										</div>
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-md-6">
									<div class="form-group">
										<label style="font-weight:bold">New Password</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-lock"></i>
											</span>
											<input asp-for="NewPassword" class="form-control" type="password" required />
										</div>
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-md-6">
									<div class="form-group">
										<label style="font-weight:bold">Confirm New Password</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-lock"></i>
											</span>
											<input asp-for="ConfirmNewPassword" class="form-control" type="password" required />
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-success" type="submit" style="font-weight:bold">Change Password</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
		document.getElementById("editForm").addEventListener("submit", function(event) {

		let inputs = this.querySelectorAll("input");

		let isValid = true; // Assume the form is valid initially

		inputs.forEach(input => {
			if (!input.checkValidity()) {  // Check if the input is invalid
				input.classList.add("invalid-input"); // Add the red border class
				isValid = false; // Mark form as invalid
			} else {
				input.classList.remove("invalid-input"); // Remove red border if valid
			}
		});

		if (!isValid) {
			event.preventDefault(); // Stop form submission if there are invalid fields
		}
	});
</script>