@using BTravel.CommonDefinitions.DTOs.CommonUser;
@using BTravel.DAL.Entities;
@model CommonUserAddDTO

@{
	var successMessage = TempData["SuccessMessage"] as string;
	var errorMessage = TempData["ErrorMessage"] as string;
}
@if (!string.IsNullOrEmpty(successMessage))
{
	<script>
		Swal.fire({
			icon: 'success',
			title: 'Success!',
			text: '@successMessage'
		});
	</script>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
	<script>
		Swal.fire({
			icon: 'error',
			title: 'Error!',
			text: '@errorMessage'
		});
	</script>
}

<div class="container">
	<div class="page-inner">
		<div class="page-header">
			<h4 class="fw-bold mb-3">
				Edit Customer
				<span class="badge badge-info fw-extrabold fs-4">
					<a href="~/Users/Details/@Model.CommonUserId">#@Model.CommonUserId</a>
				</span>
			</h4>
			<ul class="breadcrumbs mb-3">
				<li class="nav-home">
					<a href="~/Dashboard/Index">
						<i class="icon-home"></i>
					</a>
				</li>
				<li class="separator">
					<i class="icon-arrow-right"></i>
				</li>
				<li class="nav-item">
					<a href="~/Users/All">Customers</a>
				</li>
				<li class="separator">
					<i class="icon-arrow-right"></i>
				</li>
				<li class="nav-item">
					<a href="#">Edit Customer</a>
				</li>
			</ul>
		</div>
		<div class="row">
			<div class="col-md-12">
				<form id="editForm" asp-action="Edit" asp-controller="Users" method="post" novalidate>
					<input hidden asp-for="CommonUserId" class="form-control" type="text" required />
					<div class="card">
						<div class="card-header">
							<div class="card-title">Customer Details</div>
						</div>
						<div class="card-body">
							<div class="row">
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Full Name</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-user"></i>
											</span>
											<input asp-for="FullName" class="form-control" type="text" required />
										</div>
									</div>
								</div>
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Company Name</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-user"></i>
											</span>
											<input asp-for="CompanyName" class="form-control" type="text" required />
										</div>
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Email</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-at"></i>
											</span>
											<input asp-for="PrimaryMail" class="form-control" type="email" required />
										</div>
									</div>
								</div>
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Phone Number</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-phone"></i>
											</span>
											<input asp-for="PhoneNumber" class="form-control" type="text" required />
										</div>
									</div>
								</div>
							</div>					
							<div class="row">
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label class="fw-extrabold text-danger">User Role</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-user"></i>
											</span>
											<select asp-for="RoleId" class="form-select form-control" required>
												<option value="1">Admin (Full Access)</option>
												<option value="2">Customer</option>
											</select>
										</div>
									</div>
								</div>
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label class="fw-extrabold text-danger">Password</label>
										<small class="form-text text-muted text-danger fw-bold">
											&nbsp;** Leave password empty to <span class="fw-extrabold">NOT</span> update the password.
										</small>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-info"></i>
											</span>
											<input asp-for="Password" class="form-control" type="password" />
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-success" type="submit" style="font-weight:bold">Save User</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
		document.getElementById("editForm").addEventListener("submit", function(event) {

		let inputs = this.querySelectorAll("input");

		let isValid = true; // Assume the form is valid initially

		inputs.forEach(input => {
			if (!input.checkValidity()) {  // Check if the input is invalid
				input.classList.add("invalid-input"); // Add the red border class
				isValid = false; // Mark form as invalid
			} else {
				input.classList.remove("invalid-input"); // Remove red border if valid
			}
		});

		if (!isValid) {
			event.preventDefault(); // Stop form submission if there are invalid fields
		}
	});
</script>