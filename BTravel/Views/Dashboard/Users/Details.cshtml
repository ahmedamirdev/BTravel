@using BTravel.CommonDefinitions.DTOs.CommonUser
@using BTravel.CommonDefinitions.Enums
@using BTravel.DAL.Entities;
@using System.Globalization
@model CommonUserDTO

@{
	var successMessage = TempData["SuccessMessage"] as string;
	var errorMessage = TempData["ErrorMessage"] as string;
}
@if (!string.IsNullOrEmpty(successMessage))
{
	<script>
		Swal.fire({
			icon: 'success',
			title: 'Success!',
			text: '@successMessage'
		});
	</script>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
	<script>
		Swal.fire({
			icon: 'error',
			title: 'Error!',
			text: '@errorMessage'
		});
	</script>
}

<div class="container">
	<div class="page-inner">
		<div class="page-header">
			<h4 class="fw-bold mb-3">Customer <span class="badge badge-info fw-extrabold fs-4">#@Model.CommonUserId</span></h4>
			<ul class="breadcrumbs mb-3">
				<li class="nav-home">
					<a href="~/Dashboard/Index">
						<i class="icon-home"></i>
					</a>
				</li>
				<li class="separator">
					<i class="icon-arrow-right"></i>
				</li>
				<li class="nav-item">
					<a href="~/Users/All">Customers</a>
				</li>
				<li class="separator">
					<i class="icon-arrow-right"></i>
				</li>
				<li class="nav-item">
					<a href="#">Customer Details</a>
				</li>
			</ul>
		</div>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">
							Customer Details
							<a href="~/Users/Edit/@Model.CommonUserId" class="btn btn-secondary btn-sm ms-2 fs-6 fw-bolder text-white">
								<i class="fas fa-pen fa-sm"></i>&nbsp;&nbsp;Edit
							</a>
						</div>
					</div>
					<div class="card-body">
						<div class="row">
							<div class="col-md-3 col-lg-3 text-wrap">
								<div class="form-group">
									<label class="text-black-50" style="font-weight:bold">Full Name</label>
									<div class="input-icon">
										<label class="fw-bold fs-5 text-wrap">@Model.FullName</label>
									</div>
								</div>
							</div>
							<div class="col-md-3 col-lg-3 text-wrap">
								<div class="form-group">
									<label class="text-black-50" style="font-weight:bold">Company Name</label>
									<div class="input-icon">
										<label class="fw-bold fs-5 text-wrap">@Model.CompanyName</label>
									</div>
								</div>
							</div>
							<div class="col-md-3 col-lg-3 text-wrap">
								<div class="form-group">
									<label class="text-black-50" style="font-weight:bold">Billing Address</label>
									<div class="input-icon">
										<label class="fw-bold fs-5 text-wrap">@Model.BillingAddress</label>
									</div>
								</div>
							</div>
							<div class="col-md-3 col-lg-3 text-wrap">
								<div class="form-group">
									<label class="text-black-50" style="font-weight:bold">Postal Code</label>
									<div class="input-icon">
										<label class="fw-bold fs-5 text-wrap">@Model.PostalCode</label>
									</div>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-md-4 col-lg-4">
								<div class="form-group">
									<label class="text-black-50" style="font-weight:bold">Email</label>
									<div class="input-icon">
										<label class="fw-bold fs-5">@Model.PrimaryMail</label>
									</div>
								</div>
							</div>
							<div class="col-md-2 col-lg-2">
								<div class="form-group">
									<label class="text-black-50" style="font-weight:bold">Phone No.</label>
									<div class="input-icon">
										<label class="fw-bold fs-5">@Model.PhoneNumber</label>
									</div>
								</div>
							</div>
							<div class="col-md-3 col-lg-3">
								<div class="form-group">
									<label class="text-black-50" style="font-weight:bold">Created At</label>
									<div class="input-icon">
										<label class="fw-bold fs-5">@Model.CreatedAt</label>
									</div>
								</div>
							</div>
							<div class="col-md-1 col-lg-1">
								<div class="form-group">
									<label class="text-black-50" style="font-weight:bold">Role</label>
									<div class="input-icon">
										@{
											if (Model.RoleId == (int)ERole.Admin)
											{
												<span class="badge badge-success fw-bolder fs-5">Admin</span>
											}
											else if (Model.RoleId == (int)ERole.Client)
											{
												<span class="badge badge-info fw-bolder fs-5">Customer</span>
											}
										}
									</div>
								</div>
							</div>
						</div>
						@* <div class="row">
							<div class="col-md-3 col-lg-3">
								<div class="form-group">
									<label class="text-black-50" style="font-weight:bold">Name on Credit Card</label>
									<div class="input-icon">
										<label class="fw-bold fs-5">@Model.CommonUser.NameOnCreditCard</label>
									</div>
								</div>
							</div>
							<div class="col-md-3 col-lg-3">
								<div class="form-group">
									<label class="text-black-50" style="font-weight:bold">Credit Card No.</label>
									<div class="input-icon">
										<label class="fw-bold fs-5">@Model.CommonUser.CardNumber</label>
									</div>
								</div>
							</div>
							<div class="col-md-3 col-lg-3">
								<div class="form-group">
									<label class="text-black-50" style="font-weight:bold">Exp. Date</label>
									<div class="input-icon">
										<label class="fw-bold fs-5">@Model.CommonUser.CardExpDate</label>
									</div>
								</div>
							</div>
							<div class="col-md-3 col-lg-3">
								<div class="form-group">
									<label class="text-black-50" style="font-weight:bold">CVC. Code</label>
									<div class="input-icon">
										<label class="fw-bold fs-5">@Model.CommonUser.CardCVC</label>
									</div>
								</div>
							</div>
						</div> *@
						<div class="row mt-3">
							<div class="col-md-4">
								<div class="form-group">
									<label class="text-black-50" style="font-weight:bold">Credit Card Details</label>
								</div>
								<div class="card card-secondary bg-secondary-gradient ms-2">
									<div class="card-body skew-shadow">
										<img src="~/DashBoardAssets/img/visa.svg" height="12.5" alt="Visa Logo" />
										<div class="row">
											<div class="col-8 pe-0">
												<h3 class="py-4 mb-0">@Model.CardNumber</h3>
											</div>
											<div class="col-4 ps-0 text-end pt-2">
												<div class="text-small text-uppercase fw-bold op-8">
													CVC
												</div>
												<h5 class="fw-bold mb-0">
													@Model.CardCVC
												</h5>
											</div>
										</div>
										<div class="row">
											<div class="col-8 pe-0">
												<h5 class="fw-bold mb-1">@Model.NameOnCreditCard</h5>
												<div class="text-small text-uppercase fw-bold op-8">
													Card Holder
												</div>
											</div>
											<div class="col-4 ps-0 text-end">
												@{
													DateTime expDate;
													var isParsed = DateTime.TryParse(Model.CardExpDate, out expDate);
													if (isParsed)
													{
														<h5 class="fw-bold mb-1">@expDate.ToString("MM-yy")</h5>
													}
													else
													{
														<h5 class="fw-bold mb-1">@Model.CardExpDate</h5>
													}
												}
												<div class="text-small text-uppercase fw-bold op-8">
													Expire
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>