@using BTravel.CommonDefinitions.DTOs.Contract;
@using BTravel.CommonDefinitions.Enums
@using BTravel.DAL.Entities;
@using System.Globalization
@model ContractDTO

@{
	var successMessage = TempData["SuccessMessage"] as string;
	var errorMessage = TempData["ErrorMessage"] as string;
	int currRoomIndex = 0;
}
@if (!string.IsNullOrEmpty(successMessage))
{
	<script>
		Swal.fire({
			icon: 'success',
			title: 'Success!',
			text: '@successMessage'
		});
	</script>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
	<script>
		Swal.fire({
			icon: 'error',
			title: 'Error!',
			text: '@errorMessage'
		});
	</script>
}

<div class="container">
	<div class="page-inner">
		<div class="page-header">
			<h4 class="fw-bold mb-3">Contract <span class="badge badge-info fw-extrabold fs-4">#@Model.ContractId</span></h4>
			<ul class="breadcrumbs mb-3">
				<li class="nav-home">
					<a href="~/Dashboard/Index">
						<i class="icon-home"></i>
					</a>
				</li>
				<li class="separator">
					<i class="icon-arrow-right"></i>
				</li>
				<li class="nav-item">
					<a href="~/Contracts/All">Contracts</a>
				</li>
				<li class="separator">
					<i class="icon-arrow-right"></i>
				</li>
				<li class="nav-item">
					<a href="#">Contract Details</a>
				</li>
			</ul>
		</div>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">
							Hotel Details
							<a href="~/Contracts/Edit/@Model.ContractId" class="btn btn-secondary btn-sm ms-2 fs-6 fw-bolder text-white">
								<i class="fas fa-pen fa-sm"></i>&nbsp;&nbsp;Edit
							</a>
						</div>
					</div>
					<div class="card-body">
						<div class="row">
							<div class="col-md-4 col-lg-4 text-wrap">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold">Hotel Name</label>
									<div class="input-icon">
										<label class="fw-bold fs-5 text-wrap">@Model.HotelName</label>
									</div>
								</div>
							</div>
							<div class="col-md-2 col-lg-2">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold">No. Of Rooms</label>
									<div class="input-icon">
										<label class="fw-bold fs-5">@Model.NoOfRooms</label>
									</div>
								</div>
							</div>
							<div class="col-md-2 col-lg-2">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold">No. Of Nights</label>
									<div class="input-icon">
										<span class="badge badge-primary fw-extrabold fs-5">@Model.NoOfNights</span>
									</div>
								</div>
							</div>
							<div class="col-md-2 col-lg-2">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold">Rate / Night</label>
									<div class="input-icon">
										<span class="badge badge-primary fw-extrabold fs-5">@Model.RatePerNight <small>EGP</small></span>
									</div>
								</div>
							</div>
							<div class="col-md-2 col-lg-2">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold">Tax Perc.(%)</label>
									<div class="input-icon">
										<span class="badge badge-primary fw-extrabold fs-5">@Model.TaxPerc</span>
									</div>
								</div>
							</div>

						</div>
						<div class="row">
							<div class="col-md-8 col-lg-8">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold">Created At</label>
									<div class="input-icon">
										<label class="fw-bold fs-5">@Model.CreatedAt</label>
									</div>
								</div>
							</div>
							<div class="col-md-2 col-lg-2">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold">SubTotal</label>
									<div class="input-icon">
										<span class="badge badge-success fw-extrabold fs-4">@Model.SubTotal <small>EGP</small></span>
									</div>
								</div>
							</div>
							<div class="col-md-2 col-lg-2">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold">Total</label>
									<div class="input-icon">
										<span class="badge badge-success fw-extrabold fs-4">@Model.Total <small>EGP</small></span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="card">
					<div class="card-header">
						<div class="card-title">
							Customer Details &nbsp;
							@{
								if (Model.StatusId == (int)EContractStatus.Pending)
								{
									<span class="badge badge-info fw-bolder">Pending</span>
								}
								else if (Model.StatusId == (int)EContractStatus.Opened)
								{
									<span class="badge badge-warning fw-bolder">Opened</span>
								}
								else if (Model.StatusId == (int)EContractStatus.Sigend)
								{
									<span class="badge badge-success fw-bolder">Signed</span>
								}
							}
						</div>
					</div>
					<div class="card-body">
						<div class="row">
							<div class="col-md-3 col-lg-3 text-wrap">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold">Full Name</label>
									<div class="input-icon">
										<label class="fw-bold fs-5 text-wrap">@Model.CommonUser.FullName</label>
									</div>
								</div>
							</div>
							<div class="col-md-3 col-lg-3 text-wrap">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold">Company Name</label>
									<div class="input-icon">
										<label class="fw-bold fs-5 text-wrap">@Model.CommonUser.CompanyName</label>
									</div>
								</div>
							</div>
							<div class="col-md-3 col-lg-3 text-wrap">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold">Billing Address</label>
									<div class="input-icon">
										<label class="fw-bold fs-5 text-wrap">@Model.CommonUser.BillingAddress</label>
									</div>
								</div>
							</div>
							<div class="col-md-3 col-lg-3 text-wrap">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold">Postal Code</label>
									<div class="input-icon">
										<label class="fw-bold fs-5 text-wrap">@Model.CommonUser.PostalCode</label>
									</div>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-md-4 col-lg-4">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold">Email</label>
									<div class="input-icon">
										<label class="fw-bold fs-5">@Model.CommonUser.PrimaryMail</label>
									</div>
								</div>
							</div>
							<div class="col-md-4 col-lg-4">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold">Phone No.</label>
									<div class="input-icon">
										<label class="fw-bold fs-5">@Model.CommonUser.PhoneNumber</label>
									</div>
								</div>
							</div>
							<div class="col-md-4 col-lg-4">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold">Signed At</label>
									<div class="input-icon">
										<label class="fw-bold fs-5">@Model.SignedAt</label>
									</div>
								</div>
							</div>
						</div>
						@* <div class="row">
							<div class="col-md-3 col-lg-3">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold" >Name on Credit Card</label>
									<div class="input-icon">
										<label class="fw-bold fs-5">@Model.CommonUser.NameOnCreditCard</label>
									</div>
								</div>
							</div>
							<div class="col-md-3 col-lg-3">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold" >Credit Card No.</label>
									<div class="input-icon">
										<label class="fw-bold fs-5">@Model.CommonUser.CardNumber</label>
									</div>
								</div>
							</div>
							<div class="col-md-3 col-lg-3">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold" >Exp. Date</label>
									<div class="input-icon">
										<label class="fw-bold fs-5">@Model.CommonUser.CardExpDate</label>
									</div>
								</div>
							</div>
							<div class="col-md-3 col-lg-3">
								<div class="form-group">
									<label class="text-black-50 fw-extrabold" >CVC. Code</label>
									<div class="input-icon">
										<label class="fw-bold fs-5">@Model.CommonUser.CardCVC</label>
									</div>
								</div>
							</div>
						</div> *@
						<div class="row mt-3">
							<div class="col-md-4">
								<div class="card card-secondary bg-secondary-gradient ms-2">
									<div class="card-body skew-shadow">
										<img src="~/DashBoardAssets/img/visa.svg" height="12.5" alt="Visa Logo" />
										<div class="row">
											<div class="col-8 pe-0">
												<h3 class="py-4 mb-0">@Model.CommonUser.CardNumber</h3>
											</div>
											<div class="col-4 ps-0 text-end pt-2">
												<div class="text-small text-uppercase fw-bold op-8">
													CVC
												</div>
												<h5 class="fw-bold mb-0">
													@Model.CommonUser.CardCVC
												</h5>
											</div>
										</div>
										<div class="row">
											<div class="col-8 pe-0">
												<h5 class="fw-bold mb-1">@Model.CommonUser.NameOnCreditCard</h5>
												<div class="text-small text-uppercase fw-bold op-8">
													Card Holder
												</div>
											</div>
											<div class="col-4 ps-0 text-end">
												@{
													DateTime expDate;
													var isParsed = DateTime.TryParse(Model.CommonUser.CardExpDate, out expDate);
													if (isParsed)
													{
														<h5 class="fw-bold mb-1">@expDate.ToString("MM-yy")</h5>
													}
													else
													{
														<h5 class="fw-bold mb-1">@Model.CommonUser.CardExpDate</h5>
													}
												}
												<div class="text-small text-uppercase fw-bold op-8">
													Expire
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="card">
					<div class="card-header">
						<div class="card-title">Room Details</div>
					</div>
					<div class="card-body">
						<div class="row">
							<div class="col-md-12 col-lg-12">
								<div class="table-responsive">
									<table id="basic-datatables" class="table align-items-center mb-0">
										<thead class="thead-light">
											<tr>
												<th scope="col" class="text-start">Room Type</th>
												<th scope="col" class="text-start">Names</th>
												<th scope="col" class="text-start">Check In</th>
												<th scope="col" class="text-start">Check Out</th>
												<th scope="col" class="text-start">No. Of Nights</th>
												<th scope="col" class="text-start">Amenities</th>
											</tr>
										</thead>
										<tbody>
											@{
												foreach (var item in Model.Rooms)
												{
													<tr>
														<th class="text-start">@item.RoomType</th>
														<td class="text-start">@item.Names</td>
														<td class="text-start">@item.CheckIn.ToShortDateString()</td>
														<td class="text-start">@item.CheckOut.ToShortDateString()</td>
														<td class="text-start">@item.NumOfNights</td>
														<td class="text-start">@item.RoomAmenities</td>
													</tr>
												}
											}
										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="card">
					<div class="card-header">
						<div class="card-title">
							Attached Files
							<button class="btn btn-secondary btn-sm ms-2 fs-6 fw-bolder text-white" data-bs-toggle="modal" data-bs-target="#uploadModal" title="Upload File" onclick="setUploadFileContractId(@Model.ContractId)">
								<i class="fas fa-plus"></i>&nbsp;&nbsp;Add new file
							</button>
						</div>
					</div>
					<div class="card-body">
						<div class="row">
							<div class="col-md-12 col-lg-12">
								<div class="table-responsive">
									<table id="basic-datatables" class="table align-items-center mb-0">
										<thead class="thead-light">
											<tr>
												<th scope="col" class="text-start">File</th>
												<th scope="col" class="text-start">Created At</th>
												<th scope="col" class="text-end">Delete</th>
											</tr>
										</thead>
										<tbody>
											@{
												foreach (var item in Model.Files)
												{
													//currRoomIndex++;
													<tr>
														<td class="text-start">

															<a href="@item.FileUrl" target="_blank" class="btn btn-sm btn-outline-primary">
																@item.FileName
															</a>

														</td>
														<th class="text-start">@item.CreatedAt</th>
														<td class="text-end">
															<button class="btn btn-icon btn-round btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal" title="Delete" onclick="setDeleteFileId(@item.FileId)">
																<i class="fas fa-times"></i>
															</button>
														</td>
													</tr>
												}
											}
										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>


<!-- Delete File Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<form id="deleteFile" method="post" asp-action="DeleteFile" asp-controller="Contracts">
				<div class="modal-header">
					<h5 class="modal-title" id="deleteModalLabel">Delete File <span id="modalDeleteContractId" class="fw-bolder"></span></h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>

				<div class="modal-body">
					<input type="hidden" name="FileId" id="DeleteFileId" />
					<h5>Are you sure you want to delete file ?</h5>
					<small class="text-danger">** All data will be lost</small>
				</div>

				<div class="modal-footer">
					<button type="submit" class="btn btn-success">Delete</button>
					<button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancel</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- Upload File Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<form id="uploadForm" method="post" enctype="multipart/form-data" asp-action="UploadFile" asp-controller="Contracts">
				<div class="modal-header">
					<h5 class="modal-title" id="uploadModalLabel">Upload File for Contract <span id="modalUploadContractId" class="fw-bolder"></span></h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>

				<div class="modal-body">
					<input type="hidden" name="ContractId" id="UploadContractId" />
					<input class="form-control" type="file" name="xfile" required />
				</div>

				<div class="modal-footer">
					<button type="submit" class="btn btn-success">Save</button>
					<button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancel</button>
				</div>
			</form>
		</div>
	</div>
</div>

<script>
	function setUploadFileContractId(id) {
		document.getElementById("UploadContractId").value = id;
		document.getElementById("modalUploadContractId").textContent = "#" + id;
	}

	function setDeleteFileId(id) {
		document.getElementById("DeleteFileId").value = id;
		document.getElementById("modalDeleteContractId").textContent = "#" + id;
	}
</script>