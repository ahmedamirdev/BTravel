@using BTravel.CommonDefinitions.DTOs.Contract;
@using BTravel.DAL.Entities;
@model ContractEditDTO

@{
	var successMessage = TempData["SuccessMessage"] as string;
	var errorMessage = TempData["ErrorMessage"] as string;
	int currRoomIndex = 0;
}
@if (!string.IsNullOrEmpty(successMessage))
{
	<script>
		Swal.fire({
		icon: 'success',
		title: 'Success!',
		text: '@successMessage'
		});
	</script>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
	<script>
		Swal.fire({
		icon: 'error',
		title: 'Error!',
		text: '@errorMessage'
		});
	</script>
}

<div class="container">
	<div class="page-inner">
		<div class="page-header">
			<h4 class="fw-bold mb-3">
				Edit Contract
				<span class="badge badge-info fw-extrabold fs-4">
					<a href="~/Contracts/Details/@Model.ContractId">#@Model.ContractId</a>
				</span>
			</h4>
			<ul class="breadcrumbs mb-3">
				<li class="nav-home">
					<a href="~/Dashboard/Index">
						<i class="icon-home"></i>
					</a>
				</li>
				<li class="separator">
					<i class="icon-arrow-right"></i>
				</li>
				<li class="nav-item">
					<a href="~/Contracts/All">Contracts</a>
				</li>
				<li class="separator">
					<i class="icon-arrow-right"></i>
				</li>
				<li class="nav-item">
					<a href="#">Edit Contract</a>
				</li>
			</ul>
		</div>
		<div class="row">
			<div class="col-md-12">
				<form id="editForm" asp-action="Edit" asp-controller="Contracts" method="post" novalidate>
					<input hidden asp-for="ContractId" class="form-control" type="text" required />
					<div class="card">
						<div class="card-header">
							<div class="card-title">Hotel Details</div>
						</div>
						<div class="card-body">
							<div class="row">
								<div class="col-md-8 col-lg-8">
									<div class="form-group">
										<label style="font-weight:bold">Hotel Name</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-home"></i>
											</span>
											<input asp-for="HotelName" class="form-control" type="text" required />
										</div>
									</div>
								</div>
								<div class="col-md-4 col-lg-4">
									<div class="form-group">
										<label style="font-weight:bold">No. Of Rooms</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-bed"></i>
											</span>
											<input asp-for="NoOfRooms" class="form-control" type="number" required />
										</div>
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-md-4 col-lg-4">
									<div class="form-group">
										<label style="font-weight:bold">Rate / Night <span class="text-warning" style="font-size:12px;">(in EURO)</span></label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-dollar-sign"></i>
											</span>
											<input asp-for="RatePerNight" class="form-control" type="number" required />
										</div>
									</div>
								</div>
								<div class="col-md-4 col-lg-4">
									<div class="form-group">
										<label style="font-weight:bold">No. Of Nights</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-moon"></i>
											</span>
											<input asp-for="NoOfNights" class="form-control" type="number" required />
										</div>
									</div>
								</div>
								<div class="col-md-4 col-lg-4">
									<div class="form-group">
										<label style="font-weight:bold">Service Perc.(%)</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-percent"></i>
											</span>
											<input asp-for="TaxPerc" class="form-control" type="number" required />
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="card">
						<div class="card-header">
							<div class="card-title">Credit Card Details</div>
						</div>
						<div class="card-body">
							<div class="row">
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Name on Credit Card</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-id-card"></i>
											</span>
											<input asp-for="NameOnCreditCard" class="form-control" type="text" />
										</div>
									</div>
								</div>
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Credit Card No.</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-credit-card"></i>
											</span>
											<input asp-for="CardNumber" class="form-control" type="text" />
										</div>
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Exp. Date</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-calendar-alt"></i>
											</span>
											<input asp-for="CardExpDate" type="date" class="form-control" />
										</div>
									</div>
								</div>
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">CVC. Code</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-credit-card"></i>
											</span>
											<input asp-for="CardCVC" class="form-control" type="text" />
										</div>
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Billing Address</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-map-marker-alt"></i>
											</span>
											<input asp-for="BillingAddress" class="form-control" type="text" />
										</div>
									</div>
								</div>
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Postal Code</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-info"></i>
											</span>
											<input asp-for="PostalCode" class="form-control" type="text" />
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="card">
						<div class="card-header">
							<div class="card-title">
								Room Details
								<button type="button" id="addRoom" class="btn btn-link">
									<span class="btn-label">
										<i class="fas fa-plus-circle"></i>
									</span>
									Add Room
								</button>
							</div>
						</div>
						<div class="card-body">
							<div class="row">
								<div class="col-md-12 col-lg-12" style="overflow-x: auto;">
									<table id="roomsTable" class="table table-striped align-items-center mt-0 mb-0">
										<thead>
											<tr>
												<th scope="col">Room Type</th>
												<th scope="col">Names</th>
												<th scope="col">Check In</th>
												<th scope="col">Check Out</th>
												<th scope="col">No. Of Nights</th>
												<th scope="col">Amenities</th>
												<th scope="col">Comments</th>
												<th scope="col">Deadline</th>
												<th scope="col" class="text-center">Remove</th>
											</tr>
										</thead>
										<tbody>
											@{
												if (Model.Rooms != null)
												{
													for (int i = 0; i < Model.Rooms.Count; i++)
													{
														<tr>
															<td><input style="width: 120px;" type="text" name="Rooms[@i].RoomType" class="form-control" value="@Model.Rooms[i].RoomType" required /></td>
															<td><input style="width: 150px;" type="text" name="Rooms[@i].Names" class="form-control" value="@Model.Rooms[i].Names" required /></td>
															<td><input style="width: 130px;" type="date" name="Rooms[@i].CheckIn" class="form-control" value="@Model.Rooms[i].CheckIn.ToString("yyyy-MM-dd")" required /></td>
															<td><input style="width: 130px;" type="date" name="Rooms[@i].CheckOut" class="form-control" value="@Model.Rooms[i].CheckOut.ToString("yyyy-MM-dd")" required /></td>
															<td><input style="width: 70px;" type="number" name="Rooms[@i].NumOfNights" class="form-control" value="@Model.Rooms[i].NumOfNights" required /></td>
															<td><input style="width: 150px;" type="text" name="Rooms[@i].RoomAmenities" class="form-control" value="@Model.Rooms[i].RoomAmenities" required /></td>
															<td><input style="width: 150px;" type="text" name="Rooms[@i].Comment" class="form-control" value="@Model.Rooms[i].Comment" /></td>
															<td><input style="width: 130px;" type="date" name="Rooms[@i].Deadline" class="form-control" value="@Model.Rooms[i].Deadline.ToString("yyyy-MM-dd")" required /></td>
															<td class="text-center"><button type="button" class="btn btn-icon btn-round btn-danger btn-sm remove-room"><i class="fas fa-times"></i></button></td>
														</tr>
														currRoomIndex = i;
													}
												}
											}
										</tbody>
									</table>
								</div>
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-success" type="submit" style="font-weight:bold">Save Contract</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
	let roomIndex = @currRoomIndex;

	$("#addRoom").click(function () {
		roomIndex++;
		let row = `<tr>
			<td><input style="width: 120px;" type="text" name="Rooms[${roomIndex}].RoomType" class="form-control" required /></td>
			<td><input style="width: 150px;" type="text" name="Rooms[${roomIndex}].Names" class="form-control" required /></td>
			<td><input style="width: 130px;" type="date" name="Rooms[${roomIndex}].CheckIn" class="form-control" required /></td>
			<td><input style="width: 130px;" type="date" name="Rooms[${roomIndex}].CheckOut" class="form-control" required /></td>
			<td><input style="width: 70px;" type="number" name="Rooms[${roomIndex}].NumOfNights" class="form-control" required /></td>
			<td><input style="width: 150px;" type="text" name="Rooms[${roomIndex}].RoomAmenities" class="form-control" required /></td>
			<td><input style="width: 150px;" type="text" name="Rooms[${roomIndex}].Comment" class="form-control" /></td>
			<td><input style="width: 130px;" type="date" name="Rooms[${roomIndex}].Deadline" class="form-control" required /></td>
			<td class="text-center"><button type="button" class="btn btn-icon btn-round btn-danger btn-sm remove-room"><i class="fas fa-times"></i></button></td>
		</tr>`;
		$("#roomsTable tbody").append(row);

		reindexRooms();
	});

	$(document).on("click", ".remove-room", function () {
		$(this).closest("tr").remove();
		reindexRooms();
	});

	function reindexRooms() {
		$("#roomsTable tbody tr").each(function (index) {
			$(this).find("input, select, textarea").each(function () {
				let name = $(this).attr("name");
				if (name) {
					let newName = name.replace(/Rooms\[\d+\]/, `Rooms[${index}]`);
					$(this).attr("name", newName);
				}
			});
		});
	}
</script>

<script>
		document.getElementById("editForm").addEventListener("submit", function(event) {

		let inputs = this.querySelectorAll("input");

		let isValid = true; // Assume the form is valid initially

		inputs.forEach(input => {
			if (!input.checkValidity()) {  // Check if the input is invalid
				input.classList.add("invalid-input"); // Add the red border class
				isValid = false; // Mark form as invalid
			} else {
				input.classList.remove("invalid-input"); // Remove red border if valid
			}
		});

		if (!isValid) {
			event.preventDefault(); // Stop form submission if there are invalid fields
		}
	});
</script>