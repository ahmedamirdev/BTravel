@using BTravel.CommonDefinitions.DTOs.Contract;
@using BTravel.DAL.Entities;
@model ContractAddDTO

@{
	var successMessage = TempData["SuccessMessage"] as string;
	var errorMessage = TempData["ErrorMessage"] as string;
}
@if (!string.IsNullOrEmpty(successMessage))
{
	<script>
		Swal.fire({
			icon: 'success',
			title: 'Success!',
			text: '@successMessage'
		});


	</script>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
	<script>
		Swal.fire({
			icon: 'error',
			title: 'Error!',
			text: '@errorMessage'
		});
	</script>
}

<div class="container">
	<div class="page-inner">
		<div class="page-header">
			<h4 class="fw-bold mb-3">Add New Contract</h4>
			<ul class="breadcrumbs mb-3">
				<li class="nav-home">
					<a href="~/Dashboard/Index">
						<i class="icon-home"></i>
					</a>
				</li>
				<li class="separator">
					<i class="icon-arrow-right"></i>
				</li>
				<li class="nav-item">
					<a href="#">Contracts</a>
				</li>
				<li class="separator">
					<i class="icon-arrow-right"></i>
				</li>
				<li class="nav-item">
					<a href="#">Add New Contract</a>
				</li>
			</ul>
		</div>
		<div class="row">
			<div class="col-md-12">
				<form id="addForm" asp-action="AddContract" asp-controller="Contracts" method="post" novalidate>
					<div class="card">
						<div class="card-header">
							<div class="card-title">Hotel Details</div>
						</div>
						<div class="card-body">
							<div class="row">
								<div class="col-md-8 col-lg-8">
									<div class="form-group">
										<label style="font-weight:bold">Hotel Name</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-home"></i>
											</span>
											<input asp-for="HotelName" class="form-control" type="text" required />
										</div>
									</div>
								</div>
								<div class="col-md-4 col-lg-4">
									<div class="form-group">
										<label style="font-weight:bold">No. Of Rooms</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-bed"></i>
											</span>
											<input asp-for="NoOfRooms" class="form-control" type="number" required />
										</div>
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-md-4 col-lg-4">
									<div class="form-group">
										<label style="font-weight:bold">Rate / Night</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-dollar-sign"></i>
											</span>
											<input asp-for="RatePerNight" class="form-control" type="number" required />
										</div>
									</div>
								</div>
								<div class="col-md-4 col-lg-4">
									<div class="form-group">
										<label style="font-weight:bold">No. Of Nights</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-moon"></i>
											</span>
											<input asp-for="NoOfNights" class="form-control" type="number" required />
										</div>
									</div>
								</div>
								<div class="col-md-4 col-lg-4">
									<div class="form-group">
										<label style="font-weight:bold">Tax Perc.(%)</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-percent"></i>
											</span>
											<input asp-for="TaxPerc" class="form-control" type="number" required />
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="card-header">
							<div class="card-title">Customer Details (New Customer)</div>
						</div>
						<div class="card-body">
							<div class="row">
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Full Name</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-user"></i>
											</span>
											<input asp-for="CommonUserAddDTO.FullName" class="form-control" type="text" required />
										</div>
									</div>
								</div>
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Company Name</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-user"></i>
											</span>
											<input asp-for="CommonUserAddDTO.CompanyName" class="form-control" type="text" required />
										</div>
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Email</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-at"></i>
											</span>
											<input asp-for="CommonUserAddDTO.PrimaryMail" class="form-control" type="email" required />
										</div>
									</div>
								</div>
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Phone Number</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-phone"></i>
											</span>
											<input asp-for="CommonUserAddDTO.PhoneNumber" class="form-control" type="text" required />
										</div>
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Name on Credit Card</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-id-card"></i>
											</span>
											<input asp-for="CommonUserAddDTO.NameOnCreditCard" class="form-control" type="text" required />
										</div>
									</div>
								</div>
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Credit Card No.</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-credit-card"></i>
											</span>
											<input asp-for="CommonUserAddDTO.CardNumber" class="form-control" type="text" required />
										</div>
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Exp. Date</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-calendar-alt"></i>
											</span>
											<input asp-for="CommonUserAddDTO.CardExpDate" type="date" class="form-control" required />
										</div>
									</div>
								</div>
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">CVC. Code</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-credit-card"></i>
											</span>
											<input asp-for="CommonUserAddDTO.CardCVC" class="form-control" type="text" required />
										</div>
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Billing Address</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-map-marker-alt"></i>
											</span>
											<input asp-for="CommonUserAddDTO.BillingAddress" class="form-control" type="text" required />
										</div>
									</div>
								</div>
								<div class="col-md-6 col-lg-6">
									<div class="form-group">
										<label style="font-weight:bold">Postal Code</label>
										<div class="input-icon">
											<span class="input-icon-addon">
												<i class="fas fa-info"></i>
											</span>
											<input asp-for="CommonUserAddDTO.PostalCode" class="form-control" type="text" required />
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="card-header">
							<div class="card-title">
								Room Details
								<button type="button" id="addRoom" class="btn btn-link">
									<span class="btn-label">
										<i class="fas fa-plus-circle"></i>
									</span>
									Add Room
								</button>
							</div>
						</div>
						<div class="card-body">
							<div class="row">
								<div class="col-md-12 col-lg-12">
									<table id="roomsTable" class="table table-striped align-items-center mt-0 mb-0">
										<thead>
											<tr>
												<th scope="col">Room Type</th>
												<th scope="col">Names</th>
												<th scope="col">Check In</th>
												<th scope="col">Check Out</th>
												<th scope="col">No. Of Nights</th>
												<th scope="col">Room Amenities</th>
												<th scope="col"></th>
											</tr>
										</thead>
										<tbody>
										</tbody>
									</table>
								</div>
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-success" type="submit" style="font-weight:bold">Save Contract</button>
							<button class="btn btn-danger" type="reset" style="font-weight:bold">Reset Form</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
	let roomIndex = 0;

	$("#addRoom").click(function () {
		let row = `<tr>
			<td><input type="text" name="Rooms[${roomIndex}].RoomType" class="form-control" required /></td>
			<td><input type="text" name="Rooms[${roomIndex}].Names" class="form-control" required /></td>
			<td><input type="date" name="Rooms[${roomIndex}].CheckIn" class="form-control" required /></td>
			<td><input type="date" name="Rooms[${roomIndex}].CheckOut" class="form-control" required /></td>
			<td><input type="number" name="Rooms[${roomIndex}].NumOfNights" class="form-control" required /></td>
			<td><input type="text" name="Rooms[${roomIndex}].RoomAmenities" class="form-control" required /></td>
			<td><button type="button" class="btn btn-icon btn-round btn-danger remove-room"><i class="fas fa-window-close"></i></button></td>
		</tr>`;
		$("#roomsTable tbody").append(row);
		roomIndex++;
	});

	$(document).on("click", ".remove-room", function () {
		$(this).closest("tr").remove();
	});
</script>

<script>
		document.getElementById("addForm").addEventListener("submit", function(event) {

		let inputs = this.querySelectorAll("input");

		let isValid = true; // Assume the form is valid initially

		inputs.forEach(input => {
			if (!input.checkValidity()) {  // Check if the input is invalid
				input.classList.add("invalid-input"); // Add the red border class
				isValid = false; // Mark form as invalid
			} else {
				input.classList.remove("invalid-input"); // Remove red border if valid
			}
		});

		if (!isValid) {
			event.preventDefault(); // Stop form submission if there are invalid fields
		}
	});
</script>