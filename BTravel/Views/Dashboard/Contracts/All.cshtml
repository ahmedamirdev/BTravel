@using BTravel.CommonDefinitions.DTOs.Contract;
@using BTravel.CommonDefinitions.Enums
@using BTravel.CommonDefinitions.Responses
@using BTravel.DAL.Entities;
@model BaseResponse<IEnumerable<ContractDTO>>;

@{
	var successMessage = TempData["SuccessMessage"] as string;
	var errorMessage = TempData["ErrorMessage"] as string;
}
@if (!string.IsNullOrEmpty(successMessage))
{
	<script>
		Swal.fire({
			icon: 'success',
			title: 'Success!',
			text: '@successMessage'
		});
	</script>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
	<script>
		Swal.fire({
			icon: 'error',
			title: 'Error!',
			text: '@errorMessage'
		});
	</script>
}


<div class="container">
	<div class="page-inner">
		<div class="page-header">
			<h4 class="fw-bold mb-3">Contracts List</h4>
			<ul class="breadcrumbs mb-3">
				<li class="nav-home">
					<a href="~/Dashboard/Index">
						<i class="icon-home"></i>
					</a>
				</li>
				<li class="separator">
					<i class="icon-arrow-right"></i>
				</li>
				<li class="nav-item">
					<a href="~/Contracts/All">Contracts</a>
				</li>
				<li class="separator">
					<i class="icon-arrow-right"></i>
				</li>
				<li class="nav-item">
					<a href="~/Contracts/All">All</a>
				</li>
			</ul>
		</div>
		<div class="row">
			<div class="col-md-12">
				<div class="table-responsive">
					@{
						if (Model.Data == null || Model.Data.Count() <= 0)
						{
							<h4 class="fw-bold mb-3">No data found</h4>
						}
					}
					<table id="basic-datatables" class="table align-items-center mb-0">
						<thead class="thead-light">
							<tr>
								<th scope="col">#ID</th>
								<th scope="col" class="text-start">Hotel</th>
								<th scope="col" class="text-start">Customer</th>
								<th scope="col" class="text-end">SubTotal</th>
								<th scope="col" class="text-end">Total</th>
								<th scope="col" class="text-end">Status</th>
								<th scope="col" class="text-center">Created At</th>
								<th scope="col" class="text-end">Actions</th>
							</tr>
						</thead>
						<tbody>
							@{
								foreach (var item in Model.Data)
								{
									<tr>
										<th scope="row">
											<a target="_blank" href="~/Contracts/Details/@item.ContractId">#@item.ContractId</a>
										</th>
										<td class="text-start">@item.HotelName</td>
										<td class="text-start">@item.CommonUser.FullName</td>
										<td class="text-end fw-extrabold">@item.SubTotal</td>
										<td class="text-end fw-extrabold">@item.Total</td>
										<td class="text-end">
											@{
												if (item.StatusId == (int)EContractStatus.Pending)
												{
													<span class="badge badge-info fw-bolder">Pending</span>
												}
												else if (item.StatusId == (int)EContractStatus.Opened)
												{
													<span class="badge badge-warning fw-bolder">Opened</span>
												}
												else if (item.StatusId == (int)EContractStatus.Sigend)
												{
													<span class="badge badge-success fw-bolder">Signed</span>
												}
											}
										</td>
										<td class="text-center">@item.CreatedAt.ToString("dd/MM/yy h:mm tt")</td>
										<td class="text-end">
											<button class="btn btn-icon btn-round btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#uploadModal" title="Upload File" onclick="setUploadFileContractId(@item.ContractId)">
												<i class="fas fa-arrow-up"></i>
											</button>

											<a target="_blank" href="~/Contracts/Edit/@item.ContractId" class="btn btn-icon btn-round btn-info btn-sm" title="Edit">
												<i class="fas fa-pen fa-xs"></i>
											</a>

											<button class="btn btn-icon btn-round btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal" title="Delete" onclick="setDeleteContractId(@item.ContractId)">
												<i class="fas fa-times"></i>
											</button>
										</td>
									</tr>
								}
							}
						</tbody>
					</table>
					<div class="pagination-container">
						<div class="pagination-summary">
							<p>Showing @Model.From to @Model.To of @Model.TotalCount entries</p>
						</div>
						<div class="pagination-controls">
							@if (Model.TotalPages > 1)
							{
								<ul class="pagination">
									@if ((Model.PageIndex + 1) > 1)
									{
										<li><a href="@Url.Action("All" , "Contracts", new { PageIndex = Model.PageIndex - 1 })">Prev</a></li>
									}

									@for (int i = 1; i <= Model.TotalPages; i++)
									{
										if (i == (Model.PageIndex + 1))
										{
											<li class="active"><span>@i</span></li>
										}
										else
										{
											<li><a href="@Url.Action("All" , "Contracts", new { PageIndex = i - 1 })">@i</a></li>
										}
									}

									@if ((Model.PageIndex + 1) < Model.TotalPages)
									{
										<li><a href="@Url.Action("All" , "Contracts", new { PageIndex = Model.PageIndex + 1 })">Next</a></li>
									}
								</ul>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Upload File Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<form id="uploadForm" method="post" enctype="multipart/form-data" asp-action="UploadFile" asp-controller="Contracts">
				<div class="modal-header">
					<h5 class="modal-title" id="uploadModalLabel">Upload File for Contract <span id="modalUploadContractId" class="fw-bolder"></span></h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>

				<div class="modal-body">
					<input type="hidden" name="ContractId" id="UploadContractId" />
					<input class="form-control" type="file" name="xfile" required />
				</div>

				<div class="modal-footer">
					<button type="submit" class="btn btn-success">Save</button>
					<button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancel</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- Delete Contract Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<form id="deleteContract" method="post" asp-action="Delete" asp-controller="Contracts">
				<div class="modal-header">
					<h5 class="modal-title" id="deleteModalLabel">Delete Contract <span id="modalDeleteContractId" class="fw-bolder"></span></h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>

				<div class="modal-body">
					<input type="hidden" name="ContractId" id="DeleteContractId" />
					<h5>Are you sure you want to delete contract ?</h5>
					<small class="text-danger">** All data will be lost</small>
				</div>

				<div class="modal-footer">
					<button type="submit" class="btn btn-success">Delete</button>
					<button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancel</button>
				</div>
			</form>
		</div>
	</div>
</div>

<script>
	function setUploadFileContractId(id) {
		document.getElementById("UploadContractId").value = id;
		document.getElementById("modalUploadContractId").textContent = "#" + id;
	}

	function setDeleteContractId(id) {
		document.getElementById("DeleteContractId").value = id;
		document.getElementById("modalDeleteContractId").textContent = "#" + id;
	}
</script>